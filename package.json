{
  "name": "luma-wellness",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run aliases && npm run check:urls",
    "preview": "astro preview",
    "astro": "astro",
    "check:urls": "node scripts/check-urls.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run build && npm run check:titles && npm run check:jsonld && npm run check:contrast && npm run check:experience && npm run check:locales && npm run check:face-care",
    "assets": "node scripts/prepare-assets.mjs",
    "map": "node scripts/fetch-map.mjs",
    "cards": "node scripts/normalize-cards.mjs",
    "aliases": "node scripts/trailing-slash-aliases.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "check:experience": "node scripts/check-experience.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:browser": "npm run check:intro-controls && node scripts/browser-smoke.mjs && node scripts/browser-face-care.mjs && node scripts/browser-product-scroll.mjs && npm run check:safari",
    "check:safari": "node scripts/browser-safari.mjs",
    "check:intro-controls": "node scripts/browser-intro-controls.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:face-care": "node scripts/check-face-care.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "jsonld": "^8.3.3",
    "lighthouse": "^13.4.1",
    "linkedom": "^0.18.12",
    "tailwindcss": "^4.1.14"
  }
}
