---
import type { Locale } from '../i18n/locales';
import copy from '../i18n/face-care.json';
import DeviceLoop from './DeviceLoop.astro';
import '../styles/face-care.css';
const { locale = 'de' } = Astro.props as { locale?: Locale };
---
<figure class="face-details__echo" data-face-echo>
  <DeviceLoop {locale} kind="echogram" />
  <figcaption>{copy[locale].echoCaption}</figcaption>
</figure>
