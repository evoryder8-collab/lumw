---
/**
 * Frosted daylight glass. On the bright stage it can sit anywhere, not only
 * over media (section 9.3).
 *
 * The mobile menu is a checkbox-driven CSS disclosure with no JavaScript at
 * all: the site must be fully navigable with JS disabled, and the booking
 * widget is meant to be the only interactive island on the whole site.
 */
import { Image } from 'astro:assets';
import { NAV } from '../lib/site';
import logo from '../assets/logo-luma-mark.webp';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <a class="skip" href="#main">Zum Inhalt springen</a>

  <div class="header__inner glass">
    <a class="brand" href="/" aria-label="LUMA WELLNESS by June Saurin, zur Startseite">
      <Image src={logo} alt="" width={44} height={44} loading="eager" class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">LUMA</span>
        <span class="brand__sub">WELLNESS</span>
      </span>
    </a>

    <input
      type="checkbox"
      id="nav-toggle"
      class="nav-toggle"
      aria-label="Menü öffnen und schließen"
    />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true">
      <span></span><span></span>
    </label>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link underline-gold"
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav__cta">
          <a href="/contact" class="pill">Jetzt buchen</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.75rem var(--gutter) 0;
    padding-top: max(0.75rem, env(safe-area-inset-top));
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: 0.7rem 0.9rem 0.7rem 1.1rem;
    border-radius: 999px;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0.5rem;
    padding: 0.7rem 1.1rem;
    background: var(--porcelain);
    border-radius: var(--radius-interactive);
    box-shadow: var(--shadow-float-sm);
    font-size: var(--step-small);
    font-weight: 500;
  }
  .skip:focus { left: var(--gutter); z-index: 100; }

  /* --- Brand --- */

  .brand { display: inline-flex; align-items: center; gap: 0.65rem; flex-shrink: 0; }
  .brand__mark { width: 34px; height: 34px; object-fit: contain; }

  .brand__text { display: flex; flex-direction: column; line-height: 1; }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 300;
    letter-spacing: 0.16em;
    color: var(--ink);
  }

  .brand__sub {
    font-family: var(--font-body);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.34em;
    color: var(--gold-text);
    margin-top: 3px;
  }

  /* --- Nav --- */

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2.1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .nav__link[aria-current='page'] { color: var(--ink); }

  .nav__cta .pill { padding: 0.7rem 1.5rem; font-size: 0.6875rem; }

  /* --- Mobile disclosure, CSS only --- */

  .nav-toggle { position: absolute; opacity: 0; pointer-events: none; }
  .nav-burger { display: none; }

  @media (max-width: 900px) {
    .nav-burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0 10px;
      cursor: pointer;
      border-radius: 999px;
    }
    .nav-burger span {
      display: block;
      height: 1px;
      background: var(--ink);
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s;
    }
    .nav-toggle:focus-visible + .nav-burger { outline: 2px solid var(--gold); outline-offset: 3px; }
    .nav-toggle:checked + .nav-burger span:first-child { transform: translateY(3px) rotate(45deg); }
    .nav-toggle:checked + .nav-burger span:last-child { transform: translateY(-3px) rotate(-45deg); }

    .nav {
      position: absolute;
      inset-inline: var(--gutter);
      top: calc(100% + 0.5rem);
      background: rgb(255 255 255 / 0.9);
      backdrop-filter: blur(20px) saturate(1.1);
      border-radius: var(--radius-media);
      box-shadow: var(--shadow-float), inset 0 1px 0 rgb(255 255 255 / 0.8);
      padding: 1.4rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
    }
    .nav-toggle:checked ~ .nav { opacity: 1; visibility: visible; transform: none; }

    .nav__list { flex-direction: column; align-items: stretch; gap: 0.35rem; }
    .nav__link { display: block; padding: 0.85rem 0.5rem; font-size: 0.75rem; }
    .nav__cta { margin-top: 0.6rem; }
    .nav__cta .pill { width: 100%; }
  }
</style>
