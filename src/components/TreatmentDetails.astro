---
import type { Locale } from '../i18n/locales';
import { labels } from '../i18n/content';
import Icon from './Icon.astro';
const { id, name, paragraphs, href, locale, triggerLabel } = Astro.props as {
  id: string; name: string; paragraphs: string[]; href: string; locale: Locale; triggerLabel?: string;
};
const u = labels(locale);
---
<details class="treatment-details" data-treatment-details>
  <summary class="treatment-details__trigger">{triggerLabel ?? u.details}<Icon name="plus" size={15} /></summary>
  <div class="treatment-details__panel" data-treatment-panel>
    <button type="button" class="treatment-details__close" data-treatment-close aria-label={u.close} hidden><Icon name="close" size={22} /></button>
    <p class="eyebrow">LUMA WELLNESS</p>
    <h2 id={`treatment-details-${id}`} data-treatment-title>{name}</h2>
    <slot name="media" />
    <div class="treatment-details__copy">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    <slot />
    <a class="pill sheen" href={href}>{u.book}<Icon size={18} /></a>
  </div>
</details>

<style is:global>
  .treatment-details { margin-top: .6rem; }
  .treatment-details__trigger { display: flex; align-items: center; justify-content: space-between; gap: .8rem; width: fit-content; min-height: 44px; padding: .5rem .1rem; font-size: .8rem; cursor: pointer; list-style: none; text-underline-offset: 5px; }
  .treatment-details__trigger::-webkit-details-marker { display: none; }
  .treatment-details__trigger:hover { text-decoration: underline; }
  .treatment-details__trigger:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 3px; }
  .treatment-details__panel { position: relative; }
  .treatment-details__copy { font-size: 1rem; line-height: 1.7; }
  .treatment-details__copy p + p { margin-top: 1rem; }
  .treatment-details__panel > .pill { margin-top: 1.75rem; }
  .treatment-details__panel > h2 { font-size: clamp(1.75rem, 4vw, 2.4rem); line-height: 1.12; margin: .7rem 0 1.4rem; }
  .card--signature .treatment-details__panel > h2 { color: inherit; }
  .treatment-details__panel > .eyebrow { color: #6b5730; }
  .treatment-dialog { width: min(600px, calc(100% - 2rem)); max-width: none; max-height: calc(100dvh - 2rem); margin: auto; padding: 0; overscroll-behavior: contain; border: 1px solid #fffffff0; border-radius: 26px; background: linear-gradient(130deg, #fffdf8, #f1f0e7 70%, #e3e9de); color: #19392f; box-shadow: 0 28px 100px #00190a59, 0 0 0 1px #aa956950, inset 0 2px 2px #fff, inset 0 -2px 1px #d3d2bd; }
  .treatment-dialog::backdrop { background: #0a241d80; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .treatment-dialog .treatment-details__panel { padding: 5.2rem clamp(1.5rem, 5vw, 2.7rem) 2.5rem; }
  .treatment-dialog .treatment-details__close { position: absolute; top: 1rem; left: 1rem; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid #b9b59a80; border-radius: 50%; background: linear-gradient(140deg, #fff, #e6e9dc); color: #19392f; box-shadow: 0 3px 9px #16332012, inset 0 1px 1px #fff; cursor: pointer; transition: transform .2s; }
  .treatment-dialog .treatment-details__close:active { transform: scale(.92); }
  .treatment-dialog .pill { color: #f5eddc; background: #19392f; gap: .8rem; }
  @media (prefers-reduced-motion: no-preference) {
    .treatment-dialog[open] { animation: treatment-arrive 360ms cubic-bezier(.16,1,.3,1) both; }
  }
  @keyframes treatment-arrive { from { opacity: 0; transform: translateY(20px) scale(.97); } to { opacity: 1; transform: none; } }
</style>
