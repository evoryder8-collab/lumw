---
/**
 * The location panel.
 *
 * The map is real. Street centrelines and building footprints come from
 * OpenStreetMap, fetched once by `npm run map`, projected and committed as
 * src/data/map.json, then drawn here as inline SVG. Nothing is requested from
 * a third party at runtime, so the site still needs no consent banner
 * (CLAUDE.md section 6) and there is no click-to-load gate to get past.
 *
 * Buildings are extruded: a darker copy offset up and left reads as a wall,
 * the footprint on top reads as a roof. It is a cheap trick and at this scale
 * it is convincing.
 *
 * Data © OpenStreetMap contributors, ODbL.
 */
import { BUSINESS } from '../lib/site';
import mapData from '../data/map.json';

const destination = encodeURIComponent(
  `${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}, Deutschland`,
);

const googleDir = `https://www.google.com/maps/dir/?api=1&destination=${destination}&travelmode=driving&dir_action=navigate`;
const appleDir = `https://maps.apple.com/?daddr=${destination}&dirflg=d`;
const larger = BUSINESS.mapUrl;

const pathOf = (pts: number[][], close = false) =>
  `M${pts.map((p) => p.join(' ')).join('L')}${close ? 'Z' : ''}`;

/** Extrusion offset, in map units. Up and slightly left, so the light reads
 *  as coming from the top-right corner, matching the shadows on the page. */
const EX = 4.5;
const EY = 6;

/**
 * Everything that shares a style is concatenated into ONE path element.
 * Drawn one element per way it came to 1115 paths, which the browser has to
 * lay out and rasterise individually; as eight paths it is the same picture
 * for a fraction of the DOM and the raster cost.
 */
const joinPaths = (list: number[][][], close = false) =>
  list.map((pts) => pathOf(pts, close)).join(' ');

const roofs = mapData.buildings.map((b) => b.p as number[][]);
const bases = roofs.map((r) => r.map(([x, y]) => [x + EX, y + EY]));

const buildingWalls = `${joinPaths(bases, true)} ${joinPaths(roofs, true)}`;
const buildingRoofs = joinPaths(roofs, true);

const byClass = (classes: string[]) =>
  mapData.roads.filter((r) => classes.includes(r.cls));

/** Roads are grouped by rendered width so each width is a single stroke path. */
const roadGroups = (() => {
  const majors = byClass(['motorway', 'trunk', 'primary', 'secondary', 'tertiary']);
  const minors = byClass(['unclassified', 'residential', 'living_street', 'pedestrian']);
  const buckets = new Map<number, number[][][]>();
  for (const r of [...majors, ...minors]) {
    const w = Math.round(r.w * 2) / 2;
    if (!buckets.has(w)) buckets.set(w, []);
    buckets.get(w)!.push(r.p as number[][]);
  }
  return [...buckets.entries()].sort((a, b) => b[0] - a[0]).map(([w, list]) => ({
    w,
    d: joinPaths(list),
  }));
})();

const serviceD = joinPaths(byClass(['service']).map((r) => r.p as number[][]));
const greenD = joinPaths(mapData.green.map((g) => g.p as number[][]), true);
const waterD = joinPaths(mapData.water.map((w) => w.p as number[][]), true);
---

<section class="loc" id="standort" aria-labelledby="standort-title" data-reveal2>
  <div class="loc__frame rim spot">
    <span class="spot__light" aria-hidden="true"></span>

    <div class="loc__plate">
      <svg
        class="loc__map"
        viewBox="0 0 1000 1000"
        preserveAspectRatio="xMidYMid slice"
        role="img"
        aria-label="Karte der Straßen rund um die Hauptstraße 19 in Buxtehude"
      >
        <defs>
          <linearGradient id="loc-ground" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fffdfb" />
            <stop offset="0.55" stop-color="#fdf7f2" />
            <stop offset="1" stop-color="#fbf0ea" />
          </linearGradient>
          <linearGradient id="loc-roof" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="1" stop-color="#f6ece6" />
          </linearGradient>
          {/* Everything fades out before it reaches the frame edge, so the
              map dissolves into the card instead of ending on a hard line. */}
          <radialGradient id="loc-fade" cx="0.5" cy="0.5" r="0.62">
            <stop offset="0.55" stop-color="#fff" stop-opacity="1" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="loc-mask">
            <rect width="1000" height="1000" fill="url(#loc-fade)" />
          </mask>
        </defs>

        <rect width="1000" height="1000" fill="url(#loc-ground)" />

        <g mask="url(#loc-mask)">
          {greenD && <path d={greenD} fill="#3f7652" opacity="0.1" />}
          {waterD && <path d={waterD} fill="#8fb6c9" opacity="0.28" />}

          {/* Street casings first, then the fill, which is what gives a road
              an edge instead of a flat stroke. */}
          <g class="loc__roads" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <g stroke="#e8d9cd">
              {roadGroups.map((g) => <path d={g.d} stroke-width={g.w + 2.8} />)}
            </g>
            <g stroke="#ffffff">
              {roadGroups.map((g) => <path d={g.d} stroke-width={g.w} />)}
            </g>
            {serviceD && <path d={serviceD} stroke="#f3e3d8" stroke-width="1.6" />}
          </g>

          {/* Extruded footprints: wall band under, roof on top. */}
          <g class="loc__buildings">
            <path d={buildingWalls} fill="#dcc7b8" fill-rule="evenodd" opacity="0.9" />
            <path d={buildingRoofs} fill="url(#loc-roof)" stroke="#e0cdbe" stroke-width="0.7" />
          </g>
        </g>

        {/* The approach, drawn along Hauptstraße toward the door. */}
        <path
          class="loc__approach"
          d="M96 706 C 232 668 318 596 402 548 S 470 512 500 500"
          fill="none"
        />
      </svg>

      <span class="loc__tone" aria-hidden="true"></span>

      <!-- Sits at the exact centre, which is the studio's own coordinates. -->
      <span class="loc__pin" aria-hidden="true">
        <span></span>
        <svg viewBox="0 0 24 24">
          <path d="M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z" />
          <circle cx="12" cy="10" r="2.25" />
        </svg>
      </span>

      <p class="loc__marker" aria-hidden="true">Hauptstraße 19</p>

      <p class="loc__coords" aria-hidden="true">
        <span>53.4680° N</span><i></i><span>9.6893° E</span>
      </p>

      <p class="loc__credit">© OpenStreetMap</p>
    </div>

    <div class="loc__details">
      <p class="loc__eyebrow"><span aria-hidden="true"></span><b>Studio in Buxtehude</b></p>
      <h2 id="standort-title" class="loc__title">LUMA Wellness by June Saurin</h2>
      <address class="loc__address">
        Hauptstraße 19<br />21614 Buxtehude
      </address>
      <p class="loc__hint">
        Das Studio befindet sich in der Filiale HAUTNAH.
      </p>

      <div class="loc__actions">
        <button
          class="loc__drive gleam"
          type="button"
          data-drive
          aria-expanded="false"
          aria-controls="route-choice"
        >
          <span>Route starten</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h13M14 7l5 5-5 5" fill="none" stroke="currentColor"
                  stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <a class="loc__view underline-gold" href={larger} target="_blank" rel="noopener noreferrer">
          Größere Karte öffnen
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Chooser. A native dialog would be simpler, but Safari's focus handling on
     older iOS is unreliable, so this is a plain element with its own trap. -->
<div class="choice" id="route-choice" role="dialog" aria-modal="true" aria-labelledby="route-choice-title" hidden>
  <div class="choice__panel rim">
    <button class="choice__close" type="button" data-choice-close aria-label="Auswahl schließen">
      <span aria-hidden="true"></span>
    </button>

    <p class="choice__eyebrow">LUMA Wellness <i></i> Buxtehude</p>
    <h2 id="route-choice-title" class="choice__title">Womit möchten Sie navigieren?</h2>

    <div class="choice__options">
      <a class="choice__option" href={googleDir} target="_blank" rel="noopener noreferrer" data-choice-option>
        <span class="choice__brand" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z" />
            <circle cx="12" cy="10" r="2.2" />
          </svg>
        </span>
        <strong>Google Maps</strong>
        <i class="choice__arrow" aria-hidden="true"></i>
      </a>

      <a class="choice__option" href={appleDir} target="_blank" rel="noopener noreferrer" data-choice-option>
        <span class="choice__brand" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8" />
            <path d="m14.9 9.1-1.6 4.2-4.2 1.6 1.6-4.2 4.2-1.6Z" />
          </svg>
        </span>
        <strong>Apple Karten</strong>
        <i class="choice__arrow" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>

<style>
  /* --- Frame ------------------------------------------------------------ */

  .loc { padding-block: clamp(2rem, 5vw, 3.5rem); }

  .loc__frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    border-radius: 26px;
    background:
      radial-gradient(120% 90% at 8% 100%, var(--wash-sunset) 0%, transparent 58%),
      var(--surface-strong);
    box-shadow: 0 8px 44px rgb(43 38 34 / 0.1), inset 0 1px 0 rgb(255 255 255 / 0.8);
  }

  /* --- Map plate -------------------------------------------------------- */

  .loc__plate {
    position: relative;
    min-height: clamp(19rem, 40vw, 26rem);
    overflow: hidden;
    background: var(--porcelain-deep);
  }

  .loc__map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .loc__buildings { filter: drop-shadow(0 1px 1px rgb(122 96 76 / 0.1)); }

  /* The walk-in route, drawn along the street rather than across the frame. */
  .loc__approach {
    stroke: var(--leaf-text);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: 9 11;
    opacity: 0.85;
    filter: drop-shadow(0 0 5px rgb(63 118 82 / 0.35));
  }

  @media (prefers-reduced-motion: no-preference) {
    .loc__approach { animation: route-flow 2.4s linear infinite; }
  }
  @keyframes route-flow { to { stroke-dashoffset: -40; } }

  /* Warms the whole plate into the page palette. */
  .loc__tone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      radial-gradient(circle at 50% 50%, transparent 34%, rgb(255 208 163 / 0.16) 78%, rgb(255 210 224 / 0.26) 100%),
      linear-gradient(160deg, transparent 40%, rgb(255 199 180 / 0.14));
  }

  .loc__marker {
    position: absolute;
    top: calc(50% + 1.9rem);
    left: 50%;
    translate: -50% 0;
    z-index: 6;
    margin: 0;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
    background: rgb(255 255 255 / 0.9);
    box-shadow: 0 4px 14px rgb(43 38 34 / 0.14), inset 0 0 0 1px rgb(63 118 82 / 0.24);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .loc__credit {
    position: absolute;
    right: 0.7rem;
    bottom: 0.55rem;
    z-index: 6;
    margin: 0;
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
    opacity: 0.75;
  }

  /* --- The pin ---------------------------------------------------------- */

  .loc__pin {
    position: absolute;
    top: 38%;
    left: 58%;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    translate: -50% -50%;
    pointer-events: none;
  }

  /* Three rings on one animation, offset in time so a wave is always leaving. */
  .loc__pin::before,
  .loc__pin::after,
  .loc__pin > span {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(184 147 78 / 0.55);
    border-radius: 50%;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .loc__pin::before,
    .loc__pin::after,
    .loc__pin > span { animation: pin-wave 3.8s var(--ease) infinite; }
    .loc__pin::after { animation-delay: 1.25s; }
    .loc__pin > span { animation-delay: 2.5s; }
  }

  @keyframes pin-wave {
    0%   { transform: scale(0.35); opacity: 0; }
    18%  { opacity: 0.85; }
    100% { transform: scale(1.75); opacity: 0; }
  }

  .loc__pin svg {
    position: relative;
    z-index: 2;
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: var(--gold-text);
    stroke-width: 1.5;
    stroke-linejoin: round;
    filter: drop-shadow(0 3px 8px rgb(43 38 34 / 0.28));
  }
  /* The dot at the address itself. */
  .loc__pin svg circle { fill: var(--gold-fill); stroke: none; }

  .loc__coords {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    z-index: 5;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .loc__coords i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

  /* --- Details ---------------------------------------------------------- */

  .loc__details {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: clamp(1.6rem, 3vw, 2.5rem);
  }

  .loc__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.35rem;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .loc__eyebrow span {
    width: 1.5rem;
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
  }

  .loc__title { font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.14; margin: 0; }

  .loc__address {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    font-style: normal;
    line-height: 1.42;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }

  .loc__hint { font-size: 0.8125rem; font-style: italic; color: var(--ink-mute); margin: 0.35rem 0 0; }

  .loc__actions { display: grid; gap: 0.85rem; justify-items: start; margin-top: 1.35rem; }

  .loc__drive {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 48px;
    padding: 0.85rem 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--leaf);
    color: var(--on-leaf);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 8px 24px rgb(63 118 82 / 0.34), inset 0 1px 0 rgb(255 255 255 / 0.24);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .loc__drive svg { width: 20px; height: 20px; transition: transform 0.5s var(--ease); }

  @media (hover: hover) and (pointer: fine) {
    .loc__drive:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgb(63 118 82 / 0.42); }
    .loc__drive:hover svg { transform: translateX(4px); }
  }

  .loc__view { font-size: var(--step-small); color: var(--ink-soft); }

  /* --- Chooser ---------------------------------------------------------- */

  .choice {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background: rgb(43 38 34 / 0.28);
    backdrop-filter: blur(10px);
  }
  .choice[hidden] { display: none; }

  .choice__panel {
    position: relative;
    width: min(28rem, 100%);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: 24px;
    background:
      radial-gradient(120% 80% at 10% 100%, var(--wash-sunset) 0%, transparent 60%),
      rgb(255 255 255 / 0.96);
    box-shadow: 0 30px 90px rgb(43 38 34 / 0.28), inset 0 1px 0 rgb(255 255 255 / 0.9);
  }

  @media (prefers-reduced-motion: no-preference) {
    .choice__panel { animation: choice-in 0.45s var(--ease) both; }
  }
  @keyframes choice-in {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to   { opacity: 1; transform: none; }
  }

  .choice__close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(184 147 78 / 0.3);
    cursor: pointer;
  }
  .choice__close span,
  .choice__close span::before {
    content: '';
    display: block;
    width: 13px;
    height: 1px;
    background: var(--ink);
  }
  .choice__close span { transform: rotate(45deg); }
  .choice__close span::before { transform: rotate(-90deg); }

  .choice__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .choice__eyebrow i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

  .choice__title { font-size: clamp(1.3rem, 4vw, 1.75rem); line-height: 1.14; margin: 0 0 1.5rem; }

  .choice__options { display: grid; gap: 0.75rem; }

  .choice__option {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    min-height: 60px;
    padding: 0.9rem 1.15rem;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.34), 0 6px 18px rgb(43 38 34 / 0.05);
    font-size: 0.9375rem;
    color: var(--ink);
    transition: box-shadow 0.45s var(--ease), transform 0.45s var(--ease);
  }
  .choice__option strong { font-weight: 500; }

  .choice__brand {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgb(243 231 211 / 0.8);
  }
  .choice__brand svg {
    width: 19px; height: 19px;
    fill: none; stroke: var(--leaf-text); stroke-width: 1.5; stroke-linejoin: round;
  }

  .choice__arrow {
    width: 8px; height: 8px;
    border-top: 1px solid var(--leaf-text);
    border-right: 1px solid var(--leaf-text);
    transform: rotate(45deg);
    transition: transform 0.45s var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .choice__option:hover {
      transform: translateY(-2px);
      box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.6), 0 12px 28px rgb(43 38 34 / 0.09);
    }
    .choice__option:hover .choice__arrow { transform: rotate(45deg) translate(2px, -2px); }
  }

  /* --- Responsive ------------------------------------------------------- */

  @media (max-width: 900px) {
    .loc__frame { grid-template-columns: 1fr; }
    .loc__plate { min-height: 17rem; order: -1; }
    .loc__actions { justify-items: stretch; }
    .loc__drive { justify-content: center; }
  }
</style>

<script>
  // No click-to-load gate any more: the map is inline SVG from committed
  // OpenStreetMap data, so nothing third-party is ever requested.

  const drive = document.querySelector<HTMLButtonElement>('[data-drive]');
  const choice = document.querySelector<HTMLElement>('#route-choice');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-choice-close]');
  const options = [...document.querySelectorAll<HTMLAnchorElement>('[data-choice-option]')];

  if (drive && choice) {
    let returnFocus: HTMLElement | null = null;

    const open = () => {
      returnFocus = document.activeElement as HTMLElement;
      choice.hidden = false;
      drive.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => options[0]?.focus());
    };

    const close = (restore = true) => {
      if (choice.hidden) return;
      choice.hidden = true;
      drive.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (restore) returnFocus?.focus();
    };

    drive.addEventListener('click', open);
    closeBtn?.addEventListener('click', () => close());
    choice.addEventListener('click', (e) => { if (e.target === choice) close(); });
    // Picking an app closes it without stealing focus back from the new tab.
    options.forEach((o) => o.addEventListener('click', () => close(false)));

    document.addEventListener('keydown', (e) => {
      if (choice.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key !== 'Tab') return;

      // Focus stays inside the dialog while it is open.
      const focusable = [closeBtn, ...options].filter(Boolean) as HTMLElement[];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }
</script>
