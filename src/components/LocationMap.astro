---
/**
 * The location panel.
 *
 * The map is real. Street centrelines and building footprints come from
 * OpenStreetMap, fetched once by `npm run map`, projected and committed as
 * src/data/map.json, then drawn here as inline SVG. Nothing is requested from
 * a third party at runtime, so the site still needs no consent banner
 * (CLAUDE.md section 6) and there is no click-to-load gate to get past.
 *
 * Buildings are extruded: a darker copy offset up and left reads as a wall,
 * the footprint on top reads as a roof. It is a cheap trick and at this scale
 * it is convincing.
 *
 * Data © OpenStreetMap contributors, ODbL.
 */
import { BUSINESS, url } from '../lib/site';
import mapData from '../data/map.json';
import type { Locale } from '../i18n/locales';
import { labels } from '../i18n/content';

const { locale = 'de' } = Astro.props as { locale?: Locale };
const u = labels(locale);
const copy = {
  de: { map: 'Karte rund um die Hauptstraße 19 in Buxtehude', hint: 'Das Studio befindet sich bei HAUTNAH.', drive: 'Route starten', open: 'Auf Google Maps öffnen', choose: 'Welche Karten-App möchten Sie nutzen?', apple: 'Apple Karten' },
  en: { map: 'Map around Hauptstraße 19 in Buxtehude', hint: 'The studio is inside HAUTNAH.', drive: 'Drive here', open: 'Open in Google Maps', choose: 'Which maps app would you like to use?', apple: 'Apple Maps' },
  fr: { map: 'Plan des environs de Hauptstraße 19 à Buxtehude', hint: 'Le studio se trouve chez HAUTNAH.', drive: 'Itinéraire en voiture', open: 'Ouvrir dans Google Maps', choose: 'Quelle application souhaitez-vous utiliser ?', apple: 'Plans d’Apple' },
  es: { map: 'Mapa de los alrededores de Hauptstraße 19 en Buxtehude', hint: 'El estudio está dentro de HAUTNAH.', drive: 'Cómo llegar en coche', open: 'Abrir en Google Maps', choose: '¿Qué aplicación de mapas quieres usar?', apple: 'Mapas de Apple' },
  pt: { map: 'Mapa da zona da Hauptstraße 19 em Buxtehude', hint: 'O estúdio fica dentro da HAUTNAH.', drive: 'Como chegar de carro', open: 'Abrir no Google Maps', choose: 'Que aplicação de mapas prefere?', apple: 'Mapas da Apple' },
  it: { map: 'Mappa della zona di Hauptstraße 19 a Buxtehude', hint: 'Lo studio si trova all’interno di HAUTNAH.', drive: 'Indicazioni in auto', open: 'Apri in Google Maps', choose: 'Quale app di mappe vuoi usare?', apple: 'Mappe di Apple' },
}[locale];

const destination = encodeURIComponent(
  `${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}, Deutschland`,
);

const googleDir = `https://www.google.com/maps/dir/?api=1&destination=${destination}&travelmode=driving&dir_action=navigate`;
const appleDir = `https://maps.apple.com/?daddr=${destination}&dirflg=d`;
const larger = BUSINESS.mapUrl;

const pathOf = (pts: number[][], close = false) =>
  `M${pts.map((p) => p.join(' ')).join('L')}${close ? 'Z' : ''}`;

/** Extrusion offset, in map units. Up and slightly left, so the light reads
 *  as coming from the top-right corner, matching the shadows on the page. */
const EX = 4.5;
const EY = 6;

/**
 * Everything that shares a style is concatenated into ONE path element.
 * Drawn one element per way it came to 1115 paths, which the browser has to
 * lay out and rasterise individually; as eight paths it is the same picture
 * for a fraction of the DOM and the raster cost.
 */
const joinPaths = (list: number[][][], close = false) =>
  list.map((pts) => pathOf(pts, close)).join(' ');

const roofs = mapData.buildings.map((b) => b.p as number[][]);
const bases = roofs.map((r) => r.map(([x, y]) => [x + EX, y + EY]));

const buildingWalls = `${joinPaths(bases, true)} ${joinPaths(roofs, true)}`;
const buildingRoofs = joinPaths(roofs, true);

const byClass = (classes: string[]) =>
  mapData.roads.filter((r) => classes.includes(r.cls));

/** Roads are grouped by rendered width so each width is a single stroke path. */
const roadGroups = (() => {
  const majors = byClass(['motorway', 'trunk', 'primary', 'secondary', 'tertiary']);
  const minors = byClass(['unclassified', 'residential', 'living_street', 'pedestrian']);
  const buckets = new Map<number, number[][][]>();
  for (const r of [...majors, ...minors]) {
    const w = Math.round(r.w * 2) / 2;
    if (!buckets.has(w)) buckets.set(w, []);
    buckets.get(w)!.push(r.p as number[][]);
  }
  return [...buckets.entries()].sort((a, b) => b[0] - a[0]).map(([w, list]) => ({
    w,
    d: joinPaths(list),
  }));
})();

const serviceD = joinPaths(byClass(['service']).map((r) => r.p as number[][]));
const greenD = joinPaths(mapData.green.map((g) => g.p as number[][]), true);
const waterD = joinPaths(mapData.water.map((w) => w.p as number[][]), true);
const mainStreetD = joinPaths(mapData.roads.filter((road) => road.n === 'Hauptstraße').map((road) => road.p as number[][]));
// Labels follow the surveyed streets in the committed map geometry.
const streetLabels = [
  { text: 'Stader Straße', x: 299, y: 303, angle: -23 },
  { text: 'Lutherallee', x: 307, y: 552, angle: -69 },
  { text: 'Martinstraße', x: 713, y: 548, angle: 23 },
  { text: 'Hauptstraße', x: 515, y: 677, angle: 68 },
  { text: 'Schulstraße', x: 357, y: 753, angle: -1 },
];
---

<section class="loc" id="standort" aria-labelledby="standort-title" data-reveal2>
  <div class="loc__frame rim spot">
    <span class="spot__light" aria-hidden="true"></span>

    <div class="loc__plate">
      <svg
        class="loc__map"
        viewBox="0 0 1000 1000"
        preserveAspectRatio="xMidYMid slice"
        role="img"
        aria-label={copy.map}
      >
        <defs>
          <linearGradient id="loc-ground" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#e8f0e8" />
            <stop offset="0.55" stop-color="#eef1e6" />
            <stop offset="1" stop-color="#e4ebde" />
          </linearGradient>
          <linearGradient id="loc-roof" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="1" stop-color="#e4e5d8" />
          </linearGradient>
          {/* Everything fades out before it reaches the frame edge, so the
              map dissolves into the card instead of ending on a hard line. */}
          <radialGradient id="loc-fade" cx="0.5" cy="0.5" r="0.62">
            <stop offset="0.55" stop-color="#fff" stop-opacity="1" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="loc-mask">
            <rect width="1000" height="1000" fill="url(#loc-fade)" />
          </mask>
        </defs>

        <rect width="1000" height="1000" fill="url(#loc-ground)" />

        <g mask="url(#loc-mask)">
          {greenD && <path d={greenD} fill="#85af88" opacity="0.38" />}
          {waterD && <path d={waterD} fill="#82b9cc" opacity="0.7" />}

          {/* Street casings first, then the fill, which is what gives a road
              an edge instead of a flat stroke. */}
          <g class="loc__roads" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <g stroke="#b4b9a9">
              {roadGroups.map((g) => <path d={g.d} stroke-width={g.w * 2 + 3} />)}
            </g>
            <g stroke="#ffffff">
              {roadGroups.map((g) => <path d={g.d} stroke-width={g.w * 2} />)}
            </g>
            {serviceD && <path d={serviceD} stroke="#c6cbbb" stroke-width="2" />}
          </g>

          {/* Extruded footprints: wall band under, roof on top. */}
          <g class="loc__buildings">
            <path d={buildingWalls} fill="#b2bba9" fill-rule="evenodd" opacity="0.9" />
            <path d={buildingRoofs} fill="url(#loc-roof)" stroke="#aeb5a5" stroke-width="0.9" />
          </g>
        </g>

        {/* Highlight the actual Hauptstraße geometry, with the studio pin at its coordinates. */}
        <path
          class="loc__approach"
          d={mainStreetD}
          fill="none"
        />
        <g class="loc__street-labels" aria-hidden="true">
          {streetLabels.map((label) => <text x={label.x} y={label.y} transform={`rotate(${label.angle} ${label.x} ${label.y})`} text-anchor="middle">{label.text}</text>)}
        </g>
      </svg>

      <span class="loc__tone" aria-hidden="true"></span>

      <!-- Sits at the exact centre, which is the studio's own coordinates. -->
      <span class="loc__pin" aria-hidden="true">
        <span></span>
        <svg viewBox="0 0 24 24">
          <path d="M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z" />
          <circle cx="12" cy="10" r="2.25" />
        </svg>
      </span>

      <p class="loc__marker" aria-hidden="true"><strong>LUMA Wellness</strong><span>Hauptstraße 19 · HAUTNAH</span></p>

      <span class="loc__compass" aria-hidden="true">N<svg viewBox="0 0 20 24"><path d="m10 2 6 17-6-4-6 4Z" /></svg></span>

      <p class="loc__coords" aria-hidden="true">
        <span>53.4680° N</span><i></i><span>9.6893° E</span>
      </p>

      <a class="loc__credit" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
    </div>

    <div class="loc__details">
      <p class="loc__eyebrow"><span aria-hidden="true"></span><b>{u.studio}</b></p>
      <h2 id="standort-title" class="loc__title">LUMA Wellness by June Saurin</h2>
      <address class="loc__address">
        Hauptstraße 19<br />21614 Buxtehude
      </address>
      <p class="loc__hint">
        {copy.hint}
      </p>

      <div class="loc__actions">
        <button
          class="loc__drive gleam"
          type="button"
          data-drive
          aria-expanded="false"
          aria-controls="route-choice"
          hidden
        >
          <span>{copy.drive}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h13M14 7l5 5-5 5" fill="none" stroke="currentColor"
                  stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <noscript><a href={googleDir} target="_blank" rel="noopener noreferrer">Google Maps</a> · <a href={appleDir} target="_blank" rel="noopener noreferrer">{copy.apple}</a></noscript>

        <a class="loc__view underline-gold" href={larger} target="_blank" rel="noopener noreferrer">
          <img src={url('/brand/google-maps.png')} alt="" width="22" height="22" loading="lazy" /> {copy.open}
        </a>
      </div>
    </div>
  </div>
</section>

<dialog class="choice" id="route-choice" aria-labelledby="route-choice-title">
  <div class="choice__panel rim">
    <button class="choice__close" type="button" data-choice-close aria-label={u.close}>
      <span aria-hidden="true"></span>
    </button>

    <p class="choice__eyebrow">LUMA Wellness <i></i> Buxtehude</p>
    <h2 id="route-choice-title" class="choice__title">{copy.choose}</h2>

    <div class="choice__options">
      <a class="choice__option" href={googleDir} target="_blank" rel="noopener noreferrer" data-choice-option>
        <span class="choice__brand" aria-hidden="true">
          <img src={url('/brand/google-maps.png')} width="30" height="30" alt="" loading="lazy" />
        </span>
        <strong>Google Maps</strong>
        <i class="choice__arrow" aria-hidden="true"></i>
      </a>

      <a class="choice__option" href={appleDir} target="_blank" rel="noopener noreferrer" data-choice-option>
        <span class="choice__brand" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8" />
            <path d="m14.9 9.1-1.6 4.2-4.2 1.6 1.6-4.2 4.2-1.6Z" />
          </svg>
        </span>
        <strong>{copy.apple}</strong>
        <i class="choice__arrow" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</dialog>

<style>
  /* --- Frame ------------------------------------------------------------ */

  .loc { padding-block: clamp(2rem, 5vw, 3.5rem); }

  .loc__frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    border-radius: 26px;
    background:
      radial-gradient(120% 90% at 8% 100%, var(--wash-sunset) 0%, transparent 58%),
      var(--surface-strong);
    box-shadow: 0 8px 44px rgb(43 38 34 / 0.1), inset 0 1px 0 rgb(255 255 255 / 0.8);
  }
  .loc__frame::after { content: ''; position: absolute; inset: 0; z-index: 7; pointer-events: none; border-radius: inherit; background: linear-gradient(112deg, transparent 25%, #ffffef16 40%, #ffffef60 48%, #ffffef0d 57%, transparent 70%); transform: translateX(-125%); }

  /* --- Map plate -------------------------------------------------------- */

  .loc__plate {
    position: relative;
    min-height: clamp(19rem, 40vw, 26rem);
    overflow: hidden;
    background: var(--porcelain-deep);
  }

  .loc__map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .loc__buildings { filter: drop-shadow(0 1px 1px rgb(122 96 76 / 0.1)); }

  /* The walk-in route, drawn along the street rather than across the frame. */
  .loc__approach {
    stroke: #8a7242;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 9 11;
    opacity: 0.95;
    filter: drop-shadow(0 0 3px #fff9d5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .loc__approach { animation: route-flow 2.4s linear infinite; }
    .loc__frame::after { animation: map-glint 12s ease-in-out infinite; }
  }
  @keyframes route-flow { to { stroke-dashoffset: -40; } }
  @keyframes map-glint { 0%, 65% { transform: translateX(-125%); } 87%, 100% { transform: translateX(125%); } }
  .loc__street-labels { fill: #3b5144; font: 500 24px var(--font-body); paint-order: stroke fill; stroke: #f3f5e9; stroke-width: 6px; stroke-linejoin: round; letter-spacing: 0.6px; }
  :global(body[data-ambient-sleep]) .loc__frame::after, :global(.is-offscreen) .loc__frame::after { animation-play-state: paused; }

  /* Warms the whole plate into the page palette. */
  .loc__tone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(ellipse at 50% 50%, transparent 60%, #e4eddd33);
  }

  .loc__marker {
    position: absolute;
    top: calc(50% + 1.9rem);
    left: 50%;
    translate: -50% 0;
    z-index: 6;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border: 1px solid #b1b9a3;
    border-radius: 12px;
    white-space: nowrap;
    background: #fffef6f5;
    box-shadow: 0 4px 14px rgb(43 38 34 / 0.14), inset 0 0 0 1px rgb(63 118 82 / 0.24);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    color: var(--ink);
  }
  .loc__marker strong { display: block; font-size: 0.8rem; color: #19392f; font-weight: 600; }
  .loc__marker span { display: block; margin-top: 0.12rem; }
  .loc__compass { position: absolute; right: 1rem; top: 1rem; display: grid; place-items: center; gap: 3px; padding: 0.5rem 0.7rem; border: 1px solid #b6c3ac; border-radius: 20px; background: #fffff5ba; color: #385442; font-size: 0.6rem; }
  .loc__compass svg { width: 14px; height: 17px; fill: #385442; }

  .loc__credit {
    position: absolute;
    right: 0.6rem;
    bottom: 0.2rem;
    z-index: 6;
    margin: 0;
    font-size: 0.63rem;
    padding: 0.5rem;
    color: #44563f;
  }

  /* --- The pin ---------------------------------------------------------- */

  .loc__pin {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid #ddcea6;
    border-radius: 50%;
    background: linear-gradient(145deg, #46694a, #193d2d);
    box-shadow: 0 6px 20px #2447354a, inset 0 1px 1px #f2e4bd88;
    translate: -50% -50%;
    pointer-events: none;
  }

  /* Three rings on one animation, offset in time so a wave is always leaving. */
  .loc__pin::before,
  .loc__pin::after,
  .loc__pin > span {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgb(184 147 78 / 0.55);
    border-radius: 50%;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .loc__pin::before,
    .loc__pin::after,
    .loc__pin > span { animation: pin-wave 3.8s var(--ease) infinite; }
    .loc__pin::after { animation-delay: 1.25s; }
    .loc__pin > span { animation-delay: 2.5s; }
  }

  @keyframes pin-wave {
    0%   { transform: scale(0.35); opacity: 0; }
    18%  { opacity: 0.85; }
    100% { transform: scale(1.75); opacity: 0; }
  }

  .loc__pin svg {
    position: relative;
    z-index: 2;
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: #fff4d7;
    stroke-width: 1.5;
    stroke-linejoin: round;
    filter: drop-shadow(0 3px 8px rgb(43 38 34 / 0.28));
  }
  /* The dot at the address itself. */
  .loc__pin svg circle { fill: #ebdba7; stroke: none; }

  .loc__coords {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    z-index: 5;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #3e573e;
    border: 1px solid #c2cbb9;
    border-radius: 99px;
    padding: 0.45rem 0.7rem;
    background: #fffff1cc;
  }
  .loc__coords i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

  /* --- Details ---------------------------------------------------------- */

  .loc__details {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.55rem;
    padding: clamp(1.6rem, 3vw, 2.5rem);
  }

  .loc__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.35rem;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .loc__eyebrow span {
    width: 1.5rem;
    height: 1px;
    background: linear-gradient(90deg, var(--gold), transparent);
  }

  .loc__title { font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.14; margin: 0; }

  .loc__address {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    font-style: normal;
    line-height: 1.42;
    color: var(--ink-soft);
    margin-top: 0.35rem;
  }

  .loc__hint { font-size: 0.8125rem; font-style: italic; color: var(--ink-mute); margin: 0.35rem 0 0; }

  .loc__actions { display: grid; gap: 0.85rem; justify-items: start; margin-top: 1.35rem; }

  .loc__drive {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 48px;
    padding: 0.85rem 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--leaf);
    color: var(--on-leaf);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 8px 24px rgb(63 118 82 / 0.34), inset 0 1px 0 rgb(255 255 255 / 0.24);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .loc__drive svg { width: 20px; height: 20px; transition: transform 0.5s var(--ease); }
  .loc__drive[hidden] { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .loc__drive:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgb(63 118 82 / 0.42); }
    .loc__drive:hover svg { transform: translateX(4px); }
  }

  .loc__view { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 44px; font-size: var(--step-small); color: var(--ink-soft); }
  .loc__view img { object-fit: contain; }

  /* --- Chooser ---------------------------------------------------------- */

  .choice {
    width: min(28rem, calc(100% - 2rem));
    max-height: calc(100svh - 2rem);
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 24px;
    color: var(--ink);
    background: transparent;
  }
  .choice::backdrop {
    background: rgb(10 28 21 / 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .choice__panel {
    position: relative;
    width: min(28rem, 100%);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: 24px;
    background:
      radial-gradient(120% 80% at 10% 100%, var(--wash-sunset) 0%, transparent 60%),
      rgb(255 255 255 / 0.96);
    box-shadow: 0 30px 90px rgb(43 38 34 / 0.28), inset 0 1px 0 rgb(255 255 255 / 0.9);
  }

  @media (prefers-reduced-motion: no-preference) {
    .choice[open] .choice__panel { animation: choice-in 0.45s var(--ease) both; }
  }
  @keyframes choice-in {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to   { opacity: 1; transform: none; }
  }

  .choice__close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(184 147 78 / 0.3);
    cursor: pointer;
  }
  .choice__close span,
  .choice__close span::before {
    content: '';
    display: block;
    width: 13px;
    height: 1px;
    background: var(--ink);
  }
  .choice__close span { transform: rotate(45deg); }
  .choice__close span::before { transform: rotate(-90deg); }

  .choice__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .choice__eyebrow i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

  .choice__title { font-size: clamp(1.3rem, 4vw, 1.75rem); line-height: 1.14; margin: 0 0 1.5rem; }

  .choice__options { display: grid; gap: 0.75rem; }

  .choice__option {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    min-height: 60px;
    padding: 0.9rem 1.15rem;
