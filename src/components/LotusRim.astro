---
// Fine botanical metalwork, drawn around the photograph rather than over it.
const angles = [15, 55, 95, 135, 175, 215, 255, 295, 335];
---
<svg class="lotus-rim" viewBox="0 0 600 600" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="lotus-gold" x1="50" y1="20" x2="530" y2="570" gradientUnits="userSpaceOnUse"><stop stop-color="#fff3c9"/><stop offset=".27" stop-color="#b79450"/><stop offset=".5" stop-color="#f9e9b5"/><stop offset=".76" stop-color="#8e794d"/><stop offset="1" stop-color="#e7cea0"/></linearGradient>
    <linearGradient id="lotus-pearl" x1="288" y1="35" x2="310" y2="3" gradientUnits="userSpaceOnUse"><stop stop-color="#b69359" stop-opacity=".25"/><stop offset=".65" stop-color="#ebd8b2" stop-opacity=".85"/><stop offset="1" stop-color="#fff7df"/></linearGradient>
  </defs>
  <circle cx="300" cy="300" r="273" stroke="url(#lotus-gold)" stroke-width="1.15"/>
  <circle cx="300" cy="300" r="278" stroke="url(#lotus-gold)" stroke-width=".55" stroke-dasharray="160 34 2 34" opacity=".65"/>
  {angles.map((angle) => <g transform={`rotate(${angle} 300 300)`} class="lotus-rim__bloom">
    <path d="M300 30C285 22 290 10 300 1C310 10 315 22 300 30Z" fill="url(#lotus-pearl)" stroke="url(#lotus-gold)" stroke-width=".8"/>
    <path d="M300 30C284 32 276 23 274 12C291 13 297 20 300 30ZM300 30C316 32 324 23 326 12C309 13 303 20 300 30Z" fill="url(#lotus-pearl)" stroke="url(#lotus-gold)" stroke-width=".8"/>
    <path d="M300 29V9M297 28L281 18M303 28L319 18" stroke="#ffedbd" stroke-width=".55" opacity=".8"/>
  </g>)}
</svg>
<style>
  .lotus-rim { position: absolute; inset: -5%; width: 110%; height: 110%; z-index: 1; overflow: visible; pointer-events: none; filter: drop-shadow(0 1px 2px #0d201c80); }
  @media (prefers-reduced-motion: no-preference) { :global(.motion-ready) .lotus-rim__bloom { animation: lotus-lustre 7s ease-in-out infinite alternate; } .lotus-rim__bloom:nth-of-type(3n) { animation-delay: -4s; } .lotus-rim__bloom:nth-of-type(3n + 1) { animation-delay: -2s; } }
  @keyframes lotus-lustre { from { opacity: .65; } to { opacity: 1; } }
  :global(.is-offscreen) .lotus-rim__bloom, :global(body[data-ambient-sleep]) .lotus-rim__bloom { animation-play-state: paused; }
</style>
