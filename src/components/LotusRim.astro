---
import { Image } from 'astro:assets';
import relief from '../assets/lotus-gold-relief.webp';
// Each blossom is mounted on the same circular rim, not on a separate badge.
const blossoms = [-90, 42, 138].map((angle, index) => ({
  x: 50 + Math.cos(angle * Math.PI / 180) * 50,
  y: 50 + Math.sin(angle * Math.PI / 180) * 50,
  rotation: angle + 90,
  size: index === 0 ? 15 : 12,
}));
---
<div class="lotus-rim" aria-hidden="true">
  <span class="lotus-rim__bevel"></span>
  {blossoms.map(({ x, y, rotation, size }) => <span class="lotus-rim__flower" style={`left:${x}%;top:${y}%;width:${size}%;rotate:${rotation}deg`}>
    <Image src={relief} width={240} widths={[96, 144, 192, 240]} sizes="(max-width: 760px) 58px, 96px" format="webp" quality={80} alt="" decoding="async" fetchpriority="low" />
  </span>)}
</div>
<style>
  /* The photograph and its rim share one square. Inset positions both edges,
     avoiding the global max-width rule that used to squeeze only the SVG width. */
  .lotus-rim {
    position: absolute; inset: -2.5%; width: auto; height: auto; max-width: none;
    border-radius: 50%; z-index: 1; pointer-events: none; isolation: isolate;
    box-shadow: 0 2px 3px #0a1c1780, 0 12px 24px #071b2038;
  }
  .lotus-rim::before, .lotus-rim::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 2.45%;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
  }
  .lotus-rim::before {
    background: conic-gradient(from 32deg, #8f682d, #b78d42 6%, #f8e2a3 14%, #fff4cb 18%, #c6a15a 22%, #695029 31%, #ac853f 40%, #efd595 48%, #fff1c4 53%, #b39250 62%, #76552b 71%, #d7b576 81%, #fff2c5 89%, #b08741 95%, #8f682d);
    box-shadow: inset 0 1px 1px #fff3bd, inset 0 -2px 2px #765627;
  }
  .lotus-rim::after {
    background: conic-gradient(from 0deg, transparent 0 68%, #fff9de00 71%, #fff9dea6 74%, #fffef3 75%, #fff9de70 76%, transparent 79%);
    opacity: .65;
  }
  .lotus-rim__bevel {
    position: absolute; inset: 1.1%; border: 1px solid #f5dca485; border-radius: inherit;
    box-shadow: 0 1px 1px #51371580, inset 0 1px 1px #fff4cf99;
  }
  .lotus-rim__bevel::after {
    content: ''; position: absolute; inset: 1.25%; border-radius: inherit;
    border: 1px solid #30281da6; box-shadow: 0 -1px 1px #fce1a894, inset 0 1px 3px #10291d99;
  }
  .lotus-rim__flower { position: absolute; max-width: 96px; aspect-ratio: 1; translate: -50% -50%; filter: drop-shadow(0 2px 2px #20180980); }
  /* Shift the relief outwards in its own rotated coordinates. Its base rests
     on the outer gold lip while the petals extend away from the photograph. */
  .lotus-rim__flower img { width: 100%; height: 100%; object-fit: contain; transform: translateY(-28%); }
  @media (max-width: 760px) { .lotus-rim__flower { max-width: 58px; } }
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-ready) .lotus-rim::after { animation: rim-reflection 16s linear infinite; }
  }
  @keyframes rim-reflection { to { transform: rotate(360deg); } }
  :global(.is-offscreen) .lotus-rim::after,
  :global(body[data-ambient-sleep]) .lotus-rim::after { animation-play-state: paused; }
</style>
