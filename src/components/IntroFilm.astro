---
import { getImage } from 'astro:assets';
import type { Locale } from '../i18n/locales';
import { url } from '../lib/site';
import posterSource from '../assets/film-intro.webp';
const { locale = 'de', bio = false } = Astro.props as { locale?: Locale; bio?: boolean };
const words = {
  de: ['Dürfen wir den Ton einschalten?', 'Ja - Empfohlen', 'Nein', 'Willkommen bei LUMA', 'Intro abspielen', 'Ton einschalten', 'Ton ausschalten'],
  en: ['Would you like sound on this website?', 'Yes - Recommended', 'No', 'Welcome to LUMA', 'Play the introduction', 'Turn sound on', 'Turn sound off'],
  es: ['¿Quieres activar el sonido?', 'Sí - Recomendado', 'No', 'Bienvenido a LUMA', 'Reproducir la presentación', 'Activar sonido', 'Silenciar'],
  pt: ['Gostaria de ativar o som?', 'Sim - Recomendado', 'Não', 'Bem-vindo à LUMA', 'Reproduzir a apresentação', 'Ativar som', 'Desativar som'],
  it: ['Vuoi attivare l’audio?', 'Sì - Consigliato', 'No', 'Benvenuto da LUMA', 'Riproduci la presentazione', 'Attiva audio', 'Disattiva audio'],
  fr: ["Souhaitez-vous activer le son ?", "Oui - Recommandé", "Non", "Bienvenue chez LUMA", "Lire la présentation", "Activer le son", "Couper le son"],
}[locale];
// The delivery poster is independent of the unchanged 1080p film.
const poster = await getImage({src: posterSource, width: 1280, format: 'webp', quality: 72});
const playWithSound = { de: 'Mit Ton abspielen', en: 'Play with sound', es: 'Reproducir con sonido', pt: 'Reproduzir com som', it: 'Riproduci con audio', fr: 'Lire avec le son' }[locale];
const loading = { de: 'Video wird geladen …', en: 'Loading the introduction…', es: 'Cargando el vídeo…', pt: 'A carregar o vídeo…', it: 'Caricamento del video…', fr: 'Chargement de la vidéo…' }[locale];
const controls = {
  de: ['Videosteuerung', 'Video abspielen', 'Video pausieren', 'Video erneut abspielen', 'Videoposition', 'Vollbild öffnen', 'Vollbild schließen'],
  en: ['Video controls', 'Play video', 'Pause video', 'Replay video', 'Video position', 'Enter fullscreen', 'Exit fullscreen'],
  fr: ['Commandes vidéo', 'Lire la vidéo', 'Mettre en pause', 'Revoir la vidéo', 'Position dans la vidéo', 'Passer en plein écran', 'Quitter le plein écran'],
  es: ['Controles de vídeo', 'Reproducir vídeo', 'Pausar vídeo', 'Volver a ver el vídeo', 'Posición del vídeo', 'Ver a pantalla completa', 'Salir de pantalla completa'],
  pt: ['Controlos do vídeo', 'Reproduzir vídeo', 'Pausar vídeo', 'Ver o vídeo novamente', 'Posição do vídeo', 'Ver em ecrã inteiro', 'Sair do ecrã inteiro'],
  it: ['Controlli video', 'Riproduci il video', 'Metti in pausa', 'Riguarda il video', 'Posizione nel video', 'Apri a schermo intero', 'Esci dallo schermo intero'],
}[locale];
---
<section class="intro-film" aria-label={words[3]}>
  <div class="intro-film__frame liquid-glass" tabindex="-1" data-intro-frame>
    <div class="intro-film__screen">
      <video id="luma-intro" data-intro-src={url('/media/june-intro.mp4')} data-mobile-src={url('/media/june-intro-mobile.mp4')} data-intro-film data-bio-film={bio || undefined} data-film playsinline muted={bio} preload="none" poster={poster.src} width="1920" height="1080" aria-label={words[3]}>
        <a href={url('/media/june-intro.mp4')}>{words[4]}</a>
      </video>
      <!-- Assign the source only on consent. preload is advisory, and some
           media engines otherwise probe the file before that choice. -->
      <noscript>
        <style is:inline>.intro-film [data-intro-film], .intro-film .intro-film__transport-slot { display: none; }</style>
        <video src={url('/media/june-intro.mp4')} controls playsinline preload="none" poster={poster.src} width="1920" height="1080" aria-label={words[3]}>
          <a href={url('/media/june-intro.mp4')}>{words[4]}</a>
        </video>
      </noscript>
      <img class="intro-film__poster" data-intro-poster src={poster.src} width="1280" height="720" alt="" aria-hidden="true" hidden />
      <span class="intro-film__loading" data-intro-loading role="status" hidden>{loading}</span>
      <button class="intro-film__play" data-intro-play data-label-play={words[4]} data-label-sound={playWithSound} type="button" hidden>
        <span aria-hidden="true">▷</span><span data-intro-play-label>{words[4]}</span>
      </button>
    </div>
    <div class="intro-film__transport-slot">
    <div class="intro-film__transport" data-intro-transport role="group" aria-label={controls[0]} hidden>
      <button class="intro-film__control" data-intro-toggle type="button" aria-controls="luma-intro" aria-label={controls[1]} data-label-play={controls[1]} data-label-pause={controls[2]} data-label-replay={controls[3]}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path class="transport-play" d="m8 5 11 7-11 7V5Z"/><path class="transport-pause" d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
      </button>
      <input class="intro-film__seek" data-intro-seek type="range" min="0" max="1" step="1" value="0" disabled aria-controls="luma-intro" aria-label={controls[4]} />
      <button class="intro-film__control intro-film__sound" data-intro-sound type="button" data-label-on={words[5]} data-label-off={words[6]} aria-controls="luma-intro" aria-label={words[5]} hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M11 4 5 9H2v6h3l6 5V4Z" stroke-linejoin="round" /><path class="sound-waves" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" stroke-linecap="round" /><path class="sound-slash" d="m16 9 5 6m0-6-5 6" stroke-linecap="round" /></svg>
        <span class="sr-only" data-intro-sound-label>{words[5]}</span>
      </button>
      <button class="intro-film__control" data-intro-fullscreen type="button" aria-label={controls[5]} data-label-enter={controls[5]} data-label-exit={controls[6]} hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg>
      </button>
    </div>
    </div>
    <div class="intro-film__caption"><span>LUMA WELLNESS</span><span>JUNE SAURIN</span></div>
  </div>
</section>
{!bio && <dialog class="sound-dialog" data-sound-dialog aria-labelledby="sound-question">
  <div class="sound-dialog__inner">
    <h2 id="sound-question">{words[0]}</h2>
    <div class="sound-dialog__choices">
      <button type="button" class="pill sheen" data-sound-yes>{words[1]}</button>
      <button type="button" class="sound-dialog__no" data-sound-no>{words[2]}</button>
    </div>
  </div>
</dialog>}
