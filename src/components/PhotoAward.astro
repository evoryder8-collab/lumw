---
import Photo from './Photo.astro';
import Medal from './Medal.astro';
import photograph from '../assets/june-best-massage-photo-2026.webp';
import poster from '../assets/film-june-awarded-2026.webp';
import { url } from '../lib/site';
import type { Locale } from '../i18n/locales';
const { locale = 'de' } = Astro.props as { locale?: Locale };
const t = {
  de: ['Die Kunst der Massage. In einem Bild.', 'Zürichsee · Oktober 2023 · 6:30 Uhr', 'Mitte Oktober, früh am Morgen: Auf dem Zürichsee entsteht ein Bild, das Massage als Zusammenspiel von Vertrauen, Bewegung und Balance zeigt.', '2026 reicht June die Aufnahme aus Freude am Wettbewerb bei einem internationalen Fotowettbewerb für Massagefachkräfte in Paris ein. Sie gewinnt den ersten Platz in „Best Massage Photo“.', '1. Platz · Gold · Paris 2026', 'Junes preisgekrönte Fotografie: eine Massageszene auf einer Liege im Zürichsee, im Licht der aufgehenden Sonne.'],
  en: ['The art of massage. In a single image.', 'Lake Zurich · October 2023 · 6:30 am', 'An early morning in mid-October. On Lake Zurich, a photograph captures massage through trust, movement and balance, with the rising sun behind the scene.', 'In 2026, June entered the photograph for fun in an international therapists’ photography contest in Paris. It won first place in Best Massage Photo.', '1st place · Gold · Paris 2026', 'June’s award-winning photograph: a massage scene on a treatment table in Lake Zurich, silhouetted against the sunrise.'],
  es: ['El arte del masaje. En una sola imagen.', 'Lago de Zúrich · Octubre de 2023 · 6:30 h', 'Una mañana de mediados de octubre. En el lago de Zúrich, una fotografía expresa el masaje a través de la confianza, el movimiento y el equilibrio, con el sol naciente como fondo.', 'En 2026, June presentó la imagen por diversión a un concurso internacional de fotografía para terapeutas en París. Ganó el primer premio de Best Massage Photo.', '1.er puesto · Oro · París 2026', 'La fotografía premiada de June: una escena de masaje sobre una camilla en el lago de Zúrich al amanecer.'],
  pt: ['A arte da massagem. Numa só imagem.', 'Lago de Zurique · Outubro de 2023 · 6h30', 'Uma manhã de meados de outubro. No lago de Zurique, uma fotografia traduz a massagem através da confiança, do movimento e do equilíbrio, com o nascer do sol como cenário.', 'Em 2026, June inscreveu a fotografia por diversão num concurso internacional de fotografia para terapeutas em Paris. Ganhou o primeiro lugar em Best Massage Photo.', '1.º lugar · Ouro · Paris 2026', 'A fotografia premiada da June: uma cena de massagem numa marquesa no lago de Zurique ao nascer do sol.'],
  it: ['L’arte del massaggio. In una sola immagine.', 'Lago di Zurigo · Ottobre 2023 · Ore 6:30', 'Una mattina di metà ottobre. Sul lago di Zurigo, una fotografia racconta il massaggio attraverso fiducia, movimento ed equilibrio, con il sole che sorge sullo sfondo.', 'Nel 2026, June ha iscritto la fotografia per divertimento a un concorso internazionale di fotografia per terapisti a Parigi. Ha vinto il primo premio di Best Massage Photo.', '1° posto · Oro · Parigi 2026', 'La fotografia premiata di June: una scena di massaggio su un lettino nel lago di Zurigo all’alba.'],
  th: ['ศิลปะแห่งการนวด ในภาพเดียว', 'ทะเลสาบซูริก · ตุลาคม 2023 · 6:30 น.', 'เช้าตรู่ในช่วงกลางเดือนตุลาคม ณ ทะเลสาบซูริก ภาพถ่ายนี้ถ่ายทอดศิลปะแห่งการนวดผ่านความไว้วางใจ การเคลื่อนไหว และความสมดุล ท่ามกลางแสงอาทิตย์ที่กำลังขึ้น', 'ในปี 2026 จูนส่งภาพนี้เข้าร่วมการประกวดภาพถ่ายนานาชาติสำหรับนักนวดที่ปารีสด้วยความสนุก และคว้ารางวัลชนะเลิศ Best Massage Photo', 'อันดับ 1 · เหรียญทอง · ปารีส 2026', 'ภาพถ่ายที่ได้รับรางวัลของจูน แสดงการนวดบนเตียงกลางทะเลสาบซูริกในยามพระอาทิตย์ขึ้น'],
}[locale];
const controls = {
  de: ['Video ansehen', 'Video schließen'], en: ['See Video', 'Close video'],
  es: ['Ver vídeo', 'Cerrar vídeo'], pt: ['Ver vídeo', 'Fechar vídeo'],
  it: ['Guarda il video', 'Chiudi il video'], th: ['ชมวิดีโอ', 'ปิดวิดีโอ'],
}[locale];
---
<section class="section photo-award" aria-labelledby="photo-award-title">
  <div class="shell">
    <header class="photo-award__heading"><div><p class="eyebrow">BEST MASSAGE PHOTO · 2026</p><h2 id="photo-award-title">{t[0]}</h2></div><div class="photo-award__prize"><Medal metal="gold" size={68} /><span>{t[4]}</span></div></header>
    <figure class="photo-award__image" data-fade><Photo src={photograph} alt={t[5]} widths={[480, 800, 1200, 1600, 2200]} sizes="(max-width: 1400px) 92vw, 1240px" quality={83} dissolve={false} /><figcaption>{t[1]}</figcaption></figure>
    <div class="photo-award__story"><p>{t[2]}</p><p>{t[3]} <a class="photo-award__watch" href={url('/media/june-awarded-2026.mp4')} data-award-video-open>{controls[0]}<span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 9 6-9 6Z" /></svg></span></a></p></div>
  </div>
</section>
<dialog class="award-video-dialog" data-award-video-dialog aria-labelledby="award-video-title">
  <div class="award-video-dialog__header"><button type="button" data-award-video-close aria-label={controls[1]}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button><h2 id="award-video-title">Best Massage Photo · 2026</h2></div>
  <video controls playsinline preload="none" width="720" height="1280" data-film data-award-video data-award-poster={poster.src} aria-label="Best Massage Photo · 2026"></video>
</dialog>
<style>
  .photo-award { background: #172d28; color: #f5f0e2; position: relative; }
  .photo-award__heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.5rem; }
  .photo-award .eyebrow { color: #e4ca8d; }
  .photo-award h2 { max-width: 22ch; color: #fbf6e9; font-size: clamp(2rem, 4vw, 3.8rem); }
  .photo-award__prize { flex: none; display: flex; align-items: center; gap: 0.8rem; color: #ead99f; font-size: 0.85rem; }
  .photo-award__image { margin: 0; }
  .photo-award__image :global(.media) { border-radius: 12px; border: 1px solid #e5c77540; box-shadow: 0 24px 65px #0003; }
  .photo-award__image figcaption { padding-top: 1rem; color: #dadfcf; font-size: 0.72rem; letter-spacing: 0.08em; }
  .photo-award__story { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; max-width: 980px; margin: 2rem auto 0; line-height: 1.8; color: #e1e4d8; }
  .photo-award__watch { display: inline-flex; position: relative; isolation: isolate; align-items: center; gap: .55rem; min-height: 44px; padding: .05rem .6rem; margin: .15rem .05rem; color: #b5f3b9; font-weight: 600; white-space: nowrap; text-decoration: none; border-radius: 999px; text-shadow: 0 0 16px #56d78566; transition: color .2s, transform .2s; }
  .photo-award__watch::before { content: ''; position: absolute; inset: 6px -3px; border-radius: inherit; z-index: -1; box-shadow: 0 0 18px 3px #eac36b55, inset 0 0 12px #eac36b18; border: 1px solid #e9c97445; opacity: .55; }
  .photo-award__watch span { display: grid; place-items: center; width: 25px; height: 25px; border-radius: 50%; border: 1px solid #a5e9b2b3; background: #2b704948; box-shadow: inset 0 1px 3px #b8f9c22e; }
  .photo-award__watch svg { width: 16px; height: 16px; fill: currentColor; }
  .photo-award__watch:hover { color: #e0ffe1; }
  .photo-award__watch:active { transform: scale(.96); }
  .photo-award__watch:focus-visible { outline: 2px solid #f0d58f; outline-offset: 4px; }
  .award-video-dialog { margin: auto; width: min(440px, calc(100vw - 24px), calc((100dvh - 120px) * .5625 + 20px)); max-height: calc(100dvh - 24px); padding: 8px; border: 1px solid #ead69880; border-radius: 22px; background: linear-gradient(145deg, #315347f5, #102b24); color: #f7f2e5; box-shadow: inset 0 1px 1px #fff8d970, 0 30px 90px #00170bcc; overflow: auto; }
  .award-video-dialog::backdrop { background: #061b15d1; backdrop-filter: blur(12px); }
  .award-video-dialog[open] { animation: award-film-enter .3s cubic-bezier(.16,1,.3,1) both; }
  .award-video-dialog__header { display: flex; align-items: center; gap: .5rem; padding: 0 8px 7px 0; }
  .award-video-dialog__header h2 { margin: 0; font: 500 .8rem/1.4 var(--font-body); color: inherit; }
  .award-video-dialog__header button { display: grid; place-items: center; flex: none; width: 44px; height: 44px; padding: 0; color: #f7f2e5; border: 1px solid #dfcf9d55; border-radius: 50%; background: #f0ebd810; cursor: pointer; }
  .award-video-dialog__header svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .award-video-dialog video { display: block; width: 100%; height: auto; max-height: calc(100dvh - 105px); border-radius: 14px; background: #091710; }
  @keyframes award-video-breathe { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }
  @keyframes award-film-enter { from { opacity: 0; transform: translateY(18px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: no-preference) { .photo-award__watch::before { animation: award-video-breathe 3.2s ease-in-out infinite; } }
  @media (prefers-reduced-motion: reduce) { .award-video-dialog[open] { animation: none; } }
  @media (max-width: 760px) { .photo-award__heading { align-items: start; flex-direction: column; gap: 1.25rem; } .photo-award__prize :global(.medal) { width: 44px; height: 44px; } .photo-award__story { grid-template-columns: 1fr; gap: 1rem; } }
</style>
