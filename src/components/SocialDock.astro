---
import Icon from './Icon.astro';
import { BUSINESS, url, whatsappUrl } from '../lib/site';
import { labels } from '../i18n/content';
import { routePath, type Locale } from '../i18n/locales';
const { locale = 'de' } = Astro.props as { locale?: Locale };
const ui = labels(locale);
const links = [
  { name: 'instagram' as const, label: 'Instagram', href: BUSINESS.sameAs[1] },
  { name: 'facebook' as const, label: 'Facebook', href: BUSINESS.sameAs[0] },
  { name: 'whatsapp' as const, label: 'WhatsApp', href: whatsappUrl(ui.greeting) },
];
---
<nav class="social-dock" aria-label={locale === 'de' ? 'June kontaktieren und folgen' : 'Connect with June'}>
  <a class="social-dock__book" href={url(routePath('contact', locale))} data-thumb-bar>{ui.book}<Icon size={16} /></a>
  <div class="social-dock__channels">
    {links.map((link, index) => <a class={`social-dock__link social-dock__link--${link.name}`} href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.label} · June Saurin`} style={`--dock-delay:${index * 0.55}s`}>
      <span class="social-dock__shine" aria-hidden="true"></span><Icon name={link.name} size={23} /><span class="social-dock__label" aria-hidden="true">{link.label}</span>
    </a>)}
  </div>
</nav>

<style>
  .social-dock { position: fixed; z-index: 61; right: max(1.4rem, env(safe-area-inset-right)); bottom: max(1.2rem, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 0.85rem; pointer-events: none; }
  .social-dock__channels { display: flex; gap: 0.6rem; }
  .social-dock__link { --brand: #e36be1; position: relative; isolation: isolate; display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--brand) 65%, transparent); color: var(--brand); background: radial-gradient(ellipse at 28% 0%, color-mix(in srgb, var(--brand) 24%, transparent), transparent 72%), #111e23ed; box-shadow: inset 0 1px 1px #ffffff54, inset 0 -3px 6px #00000060, 0 3px 0 #050f1466, 0 10px 25px #10231d33, 0 0 24px color-mix(in srgb, var(--brand) 16%, transparent); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); pointer-events: auto; transition: transform 420ms var(--ease), box-shadow 420ms var(--ease), border-color 300ms; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .social-dock__link--facebook { --brand: #6caaff; }
  .social-dock__link--whatsapp { --brand: #42ed91; }
  .social-dock__link :global(svg) { position: relative; stroke-width: 1.65; filter: drop-shadow(0 0 7px color-mix(in srgb, var(--brand) 30%, transparent)); }
  .social-dock__shine { position: absolute; inset: 1px; border-radius: inherit; overflow: hidden; pointer-events: none; }
  .social-dock__shine::after { content: ''; position: absolute; inset: -10%; background: linear-gradient(112deg, transparent 22%, #ffffff08 35%, #ffffff54 48%, #ffffff10 58%, transparent 72%); transform: translateX(-125%); }
  .social-dock__label { position: absolute; bottom: calc(100% + 12px); left: 50%; translate: -50% 5px; opacity: 0; visibility: hidden; padding: 0.45rem 0.65rem; border-radius: 9px; background: #132b24; color: #fff9eb; font-size: 0.68rem; pointer-events: none; transition: opacity 220ms, translate 220ms; }
  .social-dock__link:focus-visible { outline: 2px solid var(--brand); outline-offset: 5px; }
  .social-dock__link:focus-visible .social-dock__label { opacity: 1; visibility: visible; translate: -50% 0; }
  .social-dock__link:active { transform: translateY(2px) scale(0.9); transition-duration: 100ms; }
  .social-dock__book { display: none; }
  :global(body:has(#nav-toggle:checked)) .social-dock, :global(body:has(dialog[open])) .social-dock { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .social-dock__link:hover { transform: translateY(-5px) scale(1.06); border-color: var(--brand); box-shadow: inset 0 1px 1px #ffffff70, inset 0 -2px 4px #00000050, 0 15px 32px #10231d44, 0 0 30px color-mix(in srgb, var(--brand) 34%, transparent); }
    .social-dock__link:hover .social-dock__label { opacity: 1; visibility: visible; translate: -50% 0; }
  }
  @media (max-width: 900px) {
    .social-dock { left: max(0.85rem, env(safe-area-inset-left)); right: max(0.85rem, env(safe-area-inset-right)); bottom: max(0.9rem, env(safe-area-inset-bottom)); justify-content: flex-end; }
    .social-dock__link { width: 48px; height: 48px; }
    .social-dock__channels { gap: 0.5rem; }
    .social-dock__book { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; max-width: 12rem; min-height: 48px; margin-right: auto; padding: 0.65rem 0.9rem; border: 1px solid #8ba384; border-radius: 16px; background: linear-gradient(140deg, #3c6549ed, #183d2df5); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 8px 24px #142e2638, inset 0 1px 1px #dce5c964; color: #fff9e8; font-size: 0.7rem; line-height: 1.3; opacity: 0; visibility: hidden; transform: translateY(12px); transition: transform 380ms var(--ease), opacity 250ms; }
    .social-dock__book.is-up { opacity: 1; visibility: visible; transform: none; pointer-events: auto; }
    .social-dock__book :global(svg) { flex: none; }
    .social-dock__book:active { transform: scale(0.96); }
    :global(body[data-page='contact']) .social-dock__book { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) { .social-dock__shine::after { animation: dock-glint 11s ease-in-out var(--dock-delay) infinite; } }
  @keyframes dock-glint { 0%, 74% { transform: translateX(-125%); } 91%, 100% { transform: translateX(125%); } }
  :global(body[data-ambient-sleep]) .social-dock__shine::after { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .social-dock__link, .social-dock__book, .social-dock__label { transition: none; } }
  @media print { .social-dock { display: none; } }
</style>
