---
/**
 * Every photograph on the site goes through here.
 *
 * AVIF first with a WebP fallback, built at fixed widths with correct
 * width/height attributes so nothing reflows: CLS budget is 0.02 and images are
 * the usual way that gets blown.
 *
 * The dissolve treatment is section 9.3's photography direction: images should
 * melt into the porcelain stage rather than sit on it as dark rectangles. It is
 * a pseudo-element over the picture, so the source files stay untouched.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  ratio?: string;
  priority?: boolean;
  dissolve?: boolean;
  quality?: number;
  class?: string;
  /**
   * 'frame' is the default rounded plate. 'orb' drops the plate entirely and
   * masks the image into a soft circle with a shadow that follows the alpha
   * rather than the box - for cutouts that already have transparent edges,
   * where a frame just draws a white rectangle around nothing.
   */
  variant?: 'frame' | 'orb' | 'fill';
}

const {
  src, alt, widths: askedWidths, sizes, ratio,
  priority = false, dissolve = true, quality = 62,
  class: className = '', variant = 'frame',
} = Astro.props;

/**
 * Never ask for more pixels than the photograph has.
 *
 * Astro will happily upscale, and the result is a soft image in a bigger file -
 * worse on both counts. treatment-cupping is 303px wide and was being requested
 * at 900, a 3x enlargement on the two Schroepfkopf pages. Clamping here fixes
 * that everywhere at once and keeps callers free to state the widths the layout
 * actually wants.
 *
 * The source width is kept as a candidate so the largest variant is still the
 * sharpest the file can produce, and duplicates are dropped so a small image
 * does not emit the same width three times.
 */
const widths = [...new Set(askedWidths.map((w) => Math.min(w, src.width)))].sort((a, b) => a - b);
---

<div
  class:list={[
    'media',
    variant === 'orb' ? 'media--orb' : variant === 'fill' ? 'media--fill' : dissolve && 'media--dissolve',
    className,
  ]}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    {/* Without this Astro falls back to PNG for a webp source, which emits
        400kB files nobody ever downloads. WebP is the universal fallback. */}
    fallbackFormat="webp"
    {/* Without an explicit width the fallback <img src> is emitted at the
        source's intrinsic size, which meant a 534kB file sitting behind every
        picture for the handful of clients that ever read it. */}
    width={Math.max(...widths)}
    widths={widths}
    sizes={sizes}
    quality={quality}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</div>

<style>
  .media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--porcelain-deep);
    box-shadow: var(--shadow-float), var(--edge-daylight);
  }

  /* <picture> is display:inline with no height by default, so an <img> inside
     it resolving `height: 100%` has no definite parent to measure against and
     falls back to its intrinsic size. That left every framed photo whose source
     ratio differed from its box sitting short inside it, with the container's
     own background showing underneath. The wrapper has to fill the frame first. */
  .media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Edges overexpose toward the porcelain so the frame dissolves into the
     stage. Most of June's usable photography is dark - competition shots on
     black, moody studio light - and without this each one lands as a hard
     rectangle, which is the one thing section 9.3 rules out. */
  /* Fill: the photograph is the surface itself. No plate, no radius, no
     shadow - it covers whatever it is placed inside. */
  .media--fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    border-radius: 0;
    box-shadow: none;
    background: none;
  }

  /* An orb: no plate, no radius, no box shadow. The image is masked to a soft
     circle and its depth comes from drop-shadow, which follows the glyph of the
     cutout instead of a rectangle it does not fill. */
  .media--orb {
    background: none;
    box-shadow: none;
    border-radius: 0;
    overflow: visible;
  }

  /* An ellipse, not a circle, and sized farthest-side.
     The img box is 3:2, so a circle's radius is set by the corners: it reaches
     transparency at the left and right edges but is still ~90% opaque top and
     bottom, which left the pavement ending in a hard horizontal line while the
     sides faded away. farthest-side gives one radius per axis, so the falloff
     lands on all four edges. The centre sits high so more of the fade is spent
     on the foreground pavement, which is the part with the crop edge in it. */
  .media--orb :global(img) {
    object-fit: contain;
    /* Gentle now: the asset carries its own baked falloff (see
       scripts/prepare-assets.mjs), so this only rounds the silhouette rather
       than fading the picture a second time. */
    --orb-mask: radial-gradient(
      ellipse farthest-side at 50% 44%,
      #000 62%,
      rgb(0 0 0 / 0.6) 82%,
      transparent 98%
    );
    -webkit-mask-image: var(--orb-mask);
    mask-image: var(--orb-mask);
    filter: drop-shadow(0 26px 46px rgb(43 38 34 / 0.16)) drop-shadow(0 4px 10px rgb(43 38 34 / 0.08));
  }

  .media--dissolve::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(115% 85% at 50% 45%, transparent 38%, rgb(250 247 242 / 0.30) 72%, rgb(250 247 242 / 0.72) 100%),
      linear-gradient(to top, rgb(250 247 242 / 0.34), transparent 34%),
      linear-gradient(to bottom, rgb(255 253 248 / 0.22), transparent 26%);
  }

  /* The shadow is what still reads as a physical edge, so it softens too. */
  .media--dissolve { box-shadow: 0 30px 90px rgb(43 38 34 / 0.07), var(--edge-daylight); }
</style>
