---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import portrait from '../assets/june-dark-portrait.webp';
import { labels, translations } from '../i18n/content';
import { type Locale, routePath } from '../i18n/locales';
import { url } from '../lib/site';
const { locale = 'de' } = Astro.props as { locale?: Locale };
const u = labels(locale);
const heading = locale === 'de' ? 'In guten Händen.' : translations[locale].pages.about.heading;
const text = locale === 'de' ? 'June Saurin ist eine international ausgezeichnete Massage-Expertin mit langjähriger therapeutischer Erfahrung. Ursprünglich in Thailand geboren und heute in Deutschland ansässig, wuchs sie in unmittelbarer Nähe von Elite-Massagetherapeuten auf.' : translations[locale].about[0];
---
<section class="june-feature">
  <figure class="june-feature__portrait"><Photo src={portrait} alt="June Saurin" widths={[480,720,1000,1400]} sizes="(max-width: 760px) 100vw, 50vw" variant="fill" dissolve={false} /></figure>
  <div class="june-feature__copy">
    <p class="eyebrow">LUMA · BY JUNE SAURIN</p>
    <h2>{heading}</h2>
    <p>{text}</p>
    <a href={url(routePath('about', locale))} class="june-feature__link">{locale === 'de' ? 'June kennenlernen' : translations[locale].nav[1]}<Icon /></a>
    <div class="june-feature__signature">June Saurin<span>LUMA WELLNESS</span></div>
  </div>
</section>
