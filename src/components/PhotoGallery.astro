---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { labels } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import cup from '../assets/june-cup-winner.webp';
import athens from '../assets/june-athens-2023.webp';
import practice from '../assets/june-massage-in-practice.webp';
import swiss from '../assets/june-swiss-championship.webp';
import winner from '../assets/june-winner.webp';
import dark from '../assets/june-dark-portrait.webp';
import waterPortrait from '../assets/june-waterside-portrait.webp';
import water from '../assets/june-at-the-water.webp';
const { locale = 'de' } = Astro.props as { locale?: Locale };
const u = labels(locale);
const wording = {
  de: {"title": "June in Bildern.", "eyebrow": "Die Galerie", "open": "Foto vergrößern", "prev": "Vorheriges Foto", "next": "Nächstes Foto", "captions": ["June mit ihrer Goldmedaille", "June mit ihrem Pokal", "Porträt von June", "Am Zürichsee", "June am Wasser", "Athen, 2023", "Massage im Wettbewerb", "Schweizer Massage-Meisterschaft, 2023"]},
  en: {"title": "June in pictures.", "eyebrow": "The gallery", "open": "Enlarge photo", "prev": "Previous photo", "next": "Next photo", "captions": ["June with her gold medal", "June with her trophy", "A portrait of June", "By Lake Zurich", "June at the water’s edge", "Athens, 2023", "Massage in competition", "Swiss Massage Championship, 2023"]},
  es: {"title": "June en imágenes.", "eyebrow": "La galería", "open": "Ampliar foto", "prev": "Foto anterior", "next": "Siguiente foto", "captions": ["June con su medalla de oro", "June con su trofeo", "Un retrato de June", "Junto al lago de Zúrich", "June a orillas del lago", "Atenas, 2023", "Masaje en competición", "Swiss Massage Championship, 2023"]},
  pt: {"title": "A June em imagens.", "eyebrow": "A galeria", "open": "Ampliar fotografia", "prev": "Fotografia anterior", "next": "Fotografia seguinte", "captions": ["A June com a sua medalha de ouro", "A June com o seu troféu", "Retrato da June", "Junto ao lago de Zurique", "A June à beira do lago", "Atenas, 2023", "Massagem em competição", "Swiss Massage Championship, 2023"]},
  it: {"title": "June in immagini.", "eyebrow": "La galleria", "open": "Ingrandisci foto", "prev": "Foto precedente", "next": "Foto successiva", "captions": ["June con la sua medaglia d’oro", "June con il suo trofeo", "Un ritratto di June", "Sul lago di Zurigo", "June in riva al lago", "Atene, 2023", "Massaggio in gara", "Swiss Massage Championship, 2023"]},
  fr: {"title": "June en images.", "eyebrow": "La galerie", "open": "Agrandir la photo", "prev": "Photo précédente", "next": "Photo suivante", "captions": ["June avec sa médaille d’or", "June avec son trophée", "Portrait de June", "Au bord du lac de Zurich", "June au bord de l’eau", "Athènes, 2023", "Massage en compétition", "Swiss Massage Championship, 2023"]},
}[locale];
const photos = await Promise.all([winner, cup, dark, waterPortrait, water, athens, practice, swiss].map(async (src, index) => ({ src, caption: wording.captions[index], large: (await getImage({ src, width: Math.min(1400, src.width), format: 'webp', quality: 85 })).src })));
---
<section class="section photo-gallery" aria-labelledby="gallery-title">
  <div class="shell photo-gallery__heading"><div><p class="eyebrow">{wording.eyebrow}</p><h2 id="gallery-title">{wording.title}</h2></div><span class="gallery-edition" aria-hidden="true">LUMA / 01–{String(photos.length).padStart(2, '0')}</span></div>
  <div class="shell photo-gallery__track" data-gallery-track>
    {photos.map((photo, i) => <figure class="photo-gallery__item">
      <a href={photo.large} data-gallery-open data-caption={photo.caption} aria-label={`${wording.open}: ${photo.caption}`}>
        <Photo src={photo.src} alt={`June Saurin · ${photo.caption}`} widths={[360,540,720]} sizes="(max-width: 760px) 78vw, (max-width: 1100px) 43vw, 23vw" ratio="2 / 3" dissolve={false} />
        <span class="photo-gallery__expand" aria-hidden="true">↗</span>
      </a>
      <figcaption><span>0{i+1}</span>{photo.caption}</figcaption>
    </figure>)}
  </div>
</section>
<dialog class="gallery-dialog" data-gallery-dialog aria-label={wording.title}>
  <button class="gallery-dialog__close" type="button" data-gallery-close aria-label={u.close}><Icon name="close" /></button>
  <button class="gallery-dialog__prev" type="button" data-gallery-prev aria-label={wording.prev}><Icon /></button>
  <figure><img data-gallery-image alt="" /><figcaption data-gallery-caption aria-live="polite"></figcaption></figure>
  <button class="gallery-dialog__next" type="button" data-gallery-next aria-label={wording.next}><Icon /></button>
</dialog>
