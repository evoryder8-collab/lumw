---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { labels } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import cup from '../assets/june-cup-winner.webp';
import athens from '../assets/june-athens-2023.webp';
import practice from '../assets/june-massage-in-practice.webp';
import swiss from '../assets/june-swiss-championship.webp';
import winner from '../assets/june-winner.webp';
import dark from '../assets/june-dark-portrait.webp';
import waterPortrait from '../assets/june-waterside-portrait.webp';
import water from '../assets/june-at-the-water.webp';
const { locale = 'de' } = Astro.props as { locale?: Locale };
const u = labels(locale);
const wording = {
 de: { title: 'Die Person hinter der Berührung.', eyebrow: 'Einblicke · June Saurin', open: 'Foto vergrößern', prev: 'Vorheriges Foto', next: 'Nächstes Foto', captions: ['June mit ihrer Goldmedaille', 'Der Pokal in ihren Händen', 'June, persönlich', 'Ruhe am Wasser', 'Im eigenen Element', 'Athen, 2023', 'Massage im Wettbewerb', 'Schweizer Meisterschaft, 2023'] },
 en: { title: 'The person behind the touch.', eyebrow: 'A closer look · June Saurin', open: 'Enlarge photo', prev: 'Previous photo', next: 'Next photo', captions: ['June with her gold medal', 'The trophy in her hands', 'June, in person', 'Stillness by the water', 'In her element', 'Athens, 2023', 'Massage in practice', 'Swiss Massage Championship, 2023'] },
 es: { title: 'La persona detrás de cada gesto.', eyebrow: 'Una mirada cercana · June Saurin', open: 'Ampliar foto', prev: 'Foto anterior', next: 'Siguiente foto', captions: ['June con su medalla de oro', 'El trofeo en sus manos', 'June, de cerca', 'Calma junto al agua', 'En su elemento', 'Atenas, 2023', 'La dedicación en cada gesto', 'Campeonato suizo, 2023'] },
 pt: { title: 'A pessoa por trás de cada gesto.', eyebrow: 'Um olhar próximo · June Saurin', open: 'Ampliar fotografia', prev: 'Fotografia anterior', next: 'Fotografia seguinte', captions: ['June com a sua medalha de ouro', 'O troféu nas suas mãos', 'June, de perto', 'Tranquilidade junto à água', 'No seu elemento', 'Atenas, 2023', 'Dedicação em cada gesto', 'Campeonato suíço, 2023'] },
 it: { title: 'La persona dietro ogni gesto.', eyebrow: 'Uno sguardo da vicino · June Saurin', open: 'Ingrandisci foto', prev: 'Foto precedente', next: 'Foto successiva', captions: ['June con la sua medaglia d’oro', 'Il trofeo tra le mani', 'June, da vicino', 'Quiete sull’acqua', 'Nel suo elemento', 'Atene, 2023', 'La cura in ogni gesto', 'Campionato svizzero, 2023'] },
 th: { title: 'ตัวตนเบื้องหลังทุกสัมผัส', eyebrow: 'อีกมุมของจูน โซริน', open: 'ขยายภาพ', prev: 'ภาพก่อนหน้า', next: 'ภาพถัดไป', captions: ['จูนกับเหรียญทองของเธอ', 'ถ้วยรางวัลในมือของจูน', 'จูนในอีกมุมหนึ่ง', 'ความสงบริมน้ำ', 'ในจังหวะของตัวเอง', 'เอเธนส์ 2023', 'ใส่ใจในทุกสัมผัส', 'การแข่งขันชิงแชมป์สวิตเซอร์แลนด์ 2023'] },
}[locale];
const photos = await Promise.all([winner, cup, dark, waterPortrait, water, athens, practice, swiss].map(async (src, index) => ({ src, caption: wording.captions[index], large: (await getImage({ src, width: Math.min(1400, src.width), format: 'webp', quality: 85 })).src })));
---
<section class="section photo-gallery" aria-labelledby="gallery-title">
  <div class="shell photo-gallery__heading"><div><p class="eyebrow">{wording.eyebrow}</p><h2 id="gallery-title">{wording.title}</h2></div><span class="gallery-edition" aria-hidden="true">LUMA / 01–{String(photos.length).padStart(2, '0')}</span></div>
  <div class="shell photo-gallery__track" data-gallery-track>
    {photos.map((photo, i) => <figure class="photo-gallery__item">
      <a href={photo.large} data-gallery-open data-caption={photo.caption} aria-label={`${wording.open}: ${photo.caption}`}>
        <Photo src={photo.src} alt={`June Saurin · ${photo.caption}`} widths={[360,540,720]} sizes="(max-width: 760px) 78vw, (max-width: 1100px) 43vw, 23vw" ratio="2 / 3" dissolve={false} />
        <span class="photo-gallery__expand" aria-hidden="true">↗</span>
      </a>
      <figcaption><span>0{i+1}</span>{photo.caption}</figcaption>
    </figure>)}
  </div>
</section>
<dialog class="gallery-dialog" data-gallery-dialog aria-label={wording.title}>
  <button class="gallery-dialog__close" type="button" data-gallery-close aria-label={u.close}><Icon name="close" /></button>
  <button class="gallery-dialog__prev" type="button" data-gallery-prev aria-label={wording.prev}><Icon /></button>
  <figure><img data-gallery-image alt="" /><figcaption data-gallery-caption aria-live="polite"></figcaption></figure>
  <button class="gallery-dialog__next" type="button" data-gallery-next aria-label={wording.next}><Icon /></button>
</dialog>
