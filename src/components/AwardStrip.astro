---
/**
 * Chapter 2 of the scroll narrative: the credibility strip.
 *
 * Section 9.2 asks for a seamless infinite marquee, and that means a genuinely
 * duplicated track: the record is rendered twice and the whole rail translates
 * by exactly -50%, so the instant the first pass leaves the frame the second
 * sits in the identical position and the seam never shows. A single track
 * scrolling to its end leaves the strip half empty before it snaps back, which
 * is what it was doing.
 *
 * All CSS. It pauses on hover, freezes flat under reduced motion, and needs no
 * JavaScript to run.
 */
import { AWARDS } from '../lib/site';
import Medal from './Medal.astro';

/** Two identical passes. The second is hidden from assistive tech so the
 *  record is not announced twice. */
const passes = [
  { items: AWARDS, hidden: false },
  { items: AWARDS, hidden: true },
];
---

<section class="strip" aria-label="Internationale Auszeichnungen">
  <p class="strip__heading"><span></span> International ausgezeichnet <span></span></p>
  <div class="strip__viewport" tabindex="0" role="region" aria-label="Auszeichnungen durchblättern">
    <div class="strip__track">
      {
        passes.map((pass) => (
          <ul class="strip__pass" aria-hidden={pass.hidden ? 'true' : undefined}>
            {pass.items.map((a) => (
              <li class="strip__item" data-metal={a.metal}>
                <Medal metal={a.metal} size={88} />
                <span class="strip__text">
                  <span class="strip__award">{a.short}</span>
                  <span class="strip__meta">{a.event} · {a.place}</span>
                </span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .strip {
    position: relative;
    margin-top: 1.5rem;
    padding-block: 1.2rem 1.6rem;
    border-block: 1px solid #b8a36d55;
    background: radial-gradient(ellipse at 50% 0%, #42594066, transparent 65%), #162e26;
    box-shadow: inset 0 1px 0 #f0d58c2e, inset 0 -1px 0 #f0d58c1c;
  }
  .strip__heading { max-width: none; display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 0 0 0.65rem; color: #e2d8bf; font-size: 0.6rem; letter-spacing: 0.23em; text-transform: uppercase; }
  .strip__heading span { width: 28px; height: 1px; background: #e2d8bf66; }

  /* The rail runs edge to edge and fades at both ends, so items arrive and
     leave rather than popping in at a hard boundary. */
  .strip__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }

  .strip__track { display: flex; width: max-content; }

  .strip__pass {
    display: flex;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    list-style: none;
    margin: 0;
    padding: 0 clamp(0.875rem, 2vw, 1.75rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Gated on .motion-ready, which the island sets after LCP. A marquee
       running through the load window means the page never visually settles,
       and Speed Index reads that as a page that took four seconds to paint.
       It also belongs to the motion layer, so it should wait like the rest. */
    /* -50% is exactly one pass, which is what makes the loop seamless. */
    :global(.motion-ready) .strip__track { animation: marquee 52s linear infinite; }
    :global(.motion-ready) .strip:is(:hover, :focus-within) .strip__track { animation-play-state: paused; }
  }

  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  .strip__item {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    white-space: nowrap;
  }

  .strip__text { display: grid; gap: 0.35rem; }

  .strip__award {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #f7f4eb;
  }
  .strip__item[data-metal='gold'] .strip__award { color: #f3d278; }
  .strip__item[data-metal='bronze'] .strip__award { color: #efb28f; }

  .strip__meta {
    font-size: 0.72rem;
    letter-spacing: 0.025em;
    color: #d0d7cc;
  }

  @media (max-width: 720px) {
    .strip__award { font-size: 0.92rem; letter-spacing: 0.06em; }
    .strip__meta { font-size: 0.67rem; }
    .strip__item :global(.medal) { width: 78px; height: 78px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__track { animation: none; }
    /* Frozen, the second pass is just a duplicate on screen. */
    .strip__pass[aria-hidden='true'] { display: none; }
    .strip__viewport { overflow-x: auto; scrollbar-width: none; }
    .strip__viewport::-webkit-scrollbar { display: none; }
  }
</style>
