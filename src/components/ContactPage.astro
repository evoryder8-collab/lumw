---
/**
 * The contact page body, shared by all six languages so every visitor gets
 * the same sequence: who and where, the cancellation terms directly above
 * the enquiry form, the three direct channels, then the map.
 *
 * German copy is the migration original and is reproduced exactly; the five
 * translations follow the localized pages' voice (June in the third person).
 */
import type { Locale } from '../i18n/locales';
import Photo from './Photo.astro';
import CancellationPolicy from './CancellationPolicy.astro';
import EnquiryForm from './EnquiryForm.astro';
import LocationMap from './LocationMap.astro';
import { BUSINESS, whatsappUrl } from '../lib/site';
import { labels } from '../i18n/content';
import studioExterior from '../assets/studio-exterior-hautnah.webp';

interface Props { locale?: Locale; eyebrow?: string; heading?: string; lead?: string }
const { locale = 'de', eyebrow, heading, lead } = Astro.props;
const u = labels(locale);
const waLink = locale === 'de' ? whatsappUrl() : whatsappUrl(u.greeting);

type Way = [rank: string, label: string, status: string];
type Copy = {
  eyebrow: string; heading: string; lead: string; alt: string;
  enquiryEyebrow: string; enquiryTitle: string;
  whatsapp: [before: string, after: string]; email: [before: string, after: string];
  ways: string; call: Way; chat: Way; mail: Way;
};
const copies: Record<Locale, Copy> = {
  de: {
    eyebrow: 'Kontakt', heading: 'Kontakt aufnehmen',
    lead: 'Sie möchten einen Termin vereinbaren oder haben eine Frage zur Massage? Schreiben Sie mir oder rufen Sie an. Ich berate Sie persönlich und bestätige Ihren Termin direkt.',
    alt: 'Das LUMA Wellness Studio in der Filiale HAUTNAH, Hauptstraße 19 in Buxtehude',
    enquiryEyebrow: 'Ihre Anfrage', enquiryTitle: 'Schreiben Sie mir',
    whatsapp: ['Während einer Massage kann ich nicht ans Telefon gehen. Schreiben Sie mir dann gerne per WhatsApp an ', ', und ich melde mich zurück, sobald ich Zeit für Ihre Anfrage habe.'],
    email: ['Sie erreichen mich auch per E-Mail an ', ' oder über das Formular. Es bereitet Ihre Nachricht für WhatsApp oder E-Mail vor. Den Termin vereinbaren wir anschließend persönlich.'],
    ways: 'Oder direkt',
    call: ['Am schnellsten', 'Anrufen', 'Mo–Sa erreichbar'], chat: ['Jederzeit', 'WhatsApp', 'Antwort schnellstmöglich'], mail: ['Für Ausführliches', 'E-Mail', 'Antwort meist am selben Tag'],
  },
  en: {
    eyebrow: '', heading: '', lead: '',
    alt: 'The LUMA Wellness studio inside HAUTNAH, Hauptstraße 19, Buxtehude',
    enquiryEyebrow: 'Your enquiry', enquiryTitle: 'Send June a message',
    whatsapp: ['June cannot answer the phone during a massage. Send her a WhatsApp message at ', ' instead, and she will reply as soon as she is free.'],
    email: ['You can also email ', ' or use the form. It prepares your message for WhatsApp or email, and June then confirms your appointment personally.'],
    ways: 'Or directly',
    call: ['Fastest', 'Call', 'Available Mon–Sat'], chat: ['Anytime', 'WhatsApp', 'Reply as soon as possible'], mail: ['For details', 'Email', 'Usually answered the same day'],
  },
  fr: {
    eyebrow: '', heading: '', lead: '',
    alt: 'Le studio LUMA Wellness chez HAUTNAH, Hauptstraße 19 à Buxtehude',
    enquiryEyebrow: 'Votre demande', enquiryTitle: 'Écrire à June',
    whatsapp: ['June ne peut pas répondre au téléphone pendant un massage. Envoyez-lui plutôt un message WhatsApp au ', ', elle vous répondra dès qu’elle sera disponible.'],
    email: ['Vous pouvez aussi écrire à ', ' ou utiliser le formulaire. Il prépare votre message pour WhatsApp ou l’e-mail, puis June confirme personnellement votre rendez-vous.'],
    ways: 'Ou directement',
    call: ['Le plus rapide', 'Appeler', 'Joignable du lundi au samedi'], chat: ['À tout moment', 'WhatsApp', 'Réponse au plus vite'], mail: ['Pour les détails', 'E-mail', 'Réponse le plus souvent le jour même'],
  },
  es: {
    eyebrow: '', heading: '', lead: '',
    alt: 'El estudio LUMA Wellness dentro de HAUTNAH, Hauptstraße 19, Buxtehude',
    enquiryEyebrow: 'Tu consulta', enquiryTitle: 'Escribe a June',
    whatsapp: ['June no puede atender el teléfono durante un masaje. Envíale un mensaje de WhatsApp al ', ' y te responderá en cuanto esté libre.'],
    email: ['También puedes escribir a ', ' o usar el formulario. Prepara tu mensaje para WhatsApp o correo electrónico, y June confirma tu cita personalmente.'],
    ways: 'O directamente',
    call: ['Lo más rápido', 'Llamar', 'Disponible de lunes a sábado'], chat: ['En cualquier momento', 'WhatsApp', 'Respuesta lo antes posible'], mail: ['Para más detalles', 'Correo electrónico', 'Respuesta normalmente el mismo día'],
  },
  pt: {
    eyebrow: '', heading: '', lead: '',
    alt: 'O estúdio LUMA Wellness na HAUTNAH, Hauptstraße 19, Buxtehude',
    enquiryEyebrow: 'O seu pedido', enquiryTitle: 'Escreva à June',
    whatsapp: ['A June não pode atender o telefone durante uma massagem. Envie-lhe uma mensagem pelo WhatsApp para ', ' e ela responderá assim que estiver disponível.'],
    email: ['Também pode escrever para ', ' ou usar o formulário. Ele prepara a sua mensagem para WhatsApp ou e-mail, e a June confirma pessoalmente a sua marcação.'],
    ways: 'Ou diretamente',
    call: ['O mais rápido', 'Ligar', 'Disponível de segunda a sábado'], chat: ['A qualquer hora', 'WhatsApp', 'Resposta o mais breve possível'], mail: ['Para mais detalhes', 'E-mail', 'Resposta geralmente no mesmo dia'],
  },
  it: {
    eyebrow: '', heading: '', lead: '',
    alt: 'Lo studio LUMA Wellness all’interno di HAUTNAH, Hauptstraße 19, Buxtehude',
    enquiryEyebrow: 'La tua richiesta', enquiryTitle: 'Scrivi a June',
    whatsapp: ['Durante un massaggio June non può rispondere al telefono. Mandale un messaggio WhatsApp al ', ' e ti risponderà appena sarà libera.'],
    email: ['Puoi anche scrivere a ', ' o usare il modulo. Prepara il tuo messaggio per WhatsApp o e-mail, poi June conferma personalmente il tuo appuntamento.'],
    ways: 'Oppure direttamente',
    call: ['Il più rapido', 'Chiama', 'Raggiungibile dal lunedì al sabato'], chat: ['In qualsiasi momento', 'WhatsApp', 'Risposta il prima possibile'], mail: ['Per i dettagli', 'E-mail', 'Risposta di solito in giornata'],
  },
};
const c = copies[locale];
const ways = [
  { way: c.call, value: BUSINESS.phone, href: `tel:${BUSINESS.phoneE164}`,
    icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z' },
  { way: c.chat, value: BUSINESS.whatsapp, href: waLink, icon: 'M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.3A8.4 8.4 0 1 1 21 11.5Z' },
  { way: c.mail, value: BUSINESS.email, href: `mailto:${BUSINESS.email}`, icon: 'M3 6.5h18v11H3zM3 7l9 6 9-6' },
];
---

<section class="hero">
  <div class="shell hero__inner">
    <div class="hero__copy">
      <p class="eyebrow" data-fade>{eyebrow ?? c.eyebrow}</p>
      <h1 class="hero__title" data-reveal>{heading ?? c.heading}</h1>
      <p class="lede hero__lede" data-fade>{lead ?? c.lead}</p>
    </div>

    {/* The storefront is a cutout with transparent edges, so it floats as an
        orb rather than sitting in a plate that would draw a white box around
        the empty corners. */}
    <figure class="hero__orb float float--slow" data-drift>
      <span class="hero__orb-halo" aria-hidden="true"></span>
      <Photo
        src={studioExterior}
        alt={c.alt}
        widths={[480, 760, 1000]}
        sizes="(max-width: 900px) 84vw, 42vw"
        ratio="3 / 2"
        variant="orb"
        priority
      />
    </figure>
  </div>
</section>

<section class="section" data-sunbeam>
  <div class="shell cancellation-placement"><CancellationPolicy {locale} /></div>
  <div class="shell form__wrap">
    <div class="form__intro">
      <p class="eyebrow" data-fade>{c.enquiryEyebrow}</p>
      <h2 data-reveal>{c.enquiryTitle}</h2>
      <div class="prose form__prose" data-fade>
        <p>{c.whatsapp[0]}<a href={waLink} class="underline-gold" rel="noopener">{BUSINESS.whatsapp}</a>{c.whatsapp[1]}</p>
        <p>{c.email[0]}<a href={`mailto:${BUSINESS.email}`} class="underline-gold">{BUSINESS.email}</a>{c.email[1]}</p>
      </div>
    </div>

    <EnquiryForm {locale} />
  </div>
</section>

{/* Direct channels. Each one is live: the status dot breathes, the well
    behind the icon pulses a ring, the rim brightens and a gleam crosses on
    approach. */}
<section class="section--tight">
  <div class="shell">
    <p class="ways__eyebrow" data-fade>{c.ways}</p>

    <ul class="ways">
      {ways.map(({ way: [rank, label, status], value, href, icon }, i) => (
        <li class="way spot rim gleam float" data-reveal2 style={`--reveal-delay:${i * 90}ms`}>
          <span class="spot__light" aria-hidden="true"></span>
          <span class="brackets" aria-hidden="true"><span></span><span></span><span></span><span></span></span>

          <a class="way__link" href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>
            <span class="way__top">
              <span class="way__well" aria-hidden="true">
                <span class="way__ring"></span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round"><path d={icon} /></svg>
              </span>
              <span class="way__rank">{rank}</span>
            </span>

            <span class="way__label">{label}</span>
            <span class="way__value">{value}</span>

            <span class="way__foot">
              <span class="way__status"><i aria-hidden="true"></i>{status}</span>
              <svg class="way__arrow" viewBox="0 0 24 12" aria-hidden="true">
                <path d="M0 6h21M16 1l5 5-5 5" fill="none" stroke="currentColor"
                      stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<div class="shell section--tight contact-map"><LocationMap {locale} /></div>

<style>
  .cancellation-placement { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 2.5vw, 2rem); }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero__title { font-size: clamp(2.6rem, 7vw, 4.6rem); line-height: 1.02; }
  .hero__lede { margin-top: clamp(1.25rem, 2.5vw, 1.9rem); max-width: 40ch; }

  /* --- The orb ----------------------------------------------------------- */

  .hero__orb { position: relative; margin: 0; }

  /* Light pooling behind the cutout, so it reads as lit from the page rather
     than pasted on top of it. */
  .hero__orb-halo {
    position: absolute;
    inset: 4%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 46%,
      rgb(255 255 255 / 0.9) 0%,
      rgb(255 234 220 / 0.55) 42%,
      rgb(255 210 224 / 0.28) 66%,
      transparent 78%);
    filter: blur(14px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__orb-halo { animation: orb-breathe 9s ease-in-out infinite alternate; }
  }
  @keyframes orb-breathe {
    from { transform: scale(0.96); opacity: 0.85; }
    to   { transform: scale(1.06); opacity: 1; }
  }

  /* --- Form -------------------------------------------------------------- */

  .form__wrap {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .form__intro h2 { margin-bottom: 1.15rem; }
  .form__prose { max-width: 44ch; }
  .form__prose :global(p) { font-size: 0.9375rem; }

  .form {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.6rem, 3.4vw, 2.6rem);
    border-radius: 22px;
    background:
      radial-gradient(120% 80% at 90% 0%, var(--wash-sunset) 0%, transparent 58%),
      var(--surface-strong);
    box-shadow: 0 8px 40px rgb(43 38 34 / 0.08), inset 0 1px 0 rgb(255 255 255 / 0.8);
  }

  .form__label {
    margin: 0 0 0.3rem;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }

  .field { display: grid; gap: 0.45rem; }

  .field__label {
    font-size: var(--step-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 46px;
    padding: 0.85rem 1.05rem;
    font-family: var(--font-body);
    font-size: var(--step-small);
    font-weight: 300;
    color: var(--ink);
    background: rgb(255 255 255 / 0.78);
    border: 0;
    border-radius: var(--radius-interactive);
    box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.16);
    transition: box-shadow 0.4s var(--ease), background 0.4s var(--ease);
  }

  .field textarea { resize: vertical; line-height: 1.6; }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    background: rgb(255 255 255 / 0.95);
    box-shadow: inset 0 0 0 2px var(--leaf), 0 6px 22px rgb(63 118 82 / 0.12);
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .form__submit { margin-top: 0.4rem; justify-self: start; }
  .form__submit:disabled { opacity: 0.45; cursor: not-allowed; }

  .form__note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-mute);
    font-style: italic;
  }

  /* --- Direct channels ---------------------------------------------------- */

  .ways__eyebrow {
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr));
    gap: clamp(0.9rem, 2vw, 1.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .way {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 20px;
    background:
      radial-gradient(130% 90% at 12% 100%, var(--wash-pink) 0%, transparent 60%),
      radial-gradient(110% 80% at 92% 4%, var(--wash-sunset) 0%, transparent 54%),
      var(--surface-strong);
    box-shadow: 0 4px 26px rgb(43 38 34 / 0.06), inset 0 1px 0 rgb(255 255 255 / 0.78);
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
  }

  .way__link {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 0.3rem;
    padding: clamp(1.35rem, 2.6vw, 1.75rem);
    min-height: 100%;
  }

  .way__top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.6rem; }

  /* A lit well behind the icon, with a ring leaving it on a slow pulse. */
  .way__well {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 50%;
    color: var(--leaf-text);
    background: radial-gradient(circle at 42% 34%, #ffffff 0%, rgb(151 198 147 / 0.32) 74%);
    box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.22), inset 0 2px 6px rgb(255 255 255 / 0.9),
                0 4px 12px rgb(43 38 34 / 0.07);
  }
  .way__well svg { width: 19px; height: 19px; }

  .way__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgb(63 118 82 / 0.5);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .way__ring { animation: well-pulse 3.4s var(--ease) infinite; }
    .way:nth-child(2) .way__ring { animation-delay: 1.1s; }
    .way:nth-child(3) .way__ring { animation-delay: 2.2s; }
  }
  @keyframes well-pulse {
    0%   { transform: scale(0.86); opacity: 0; }
    22%  { opacity: 0.7; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  .way__rank {
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .way__label {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.08;
    color: var(--ink);
  }

  .way__value {
    font-size: var(--step-small);
    color: var(--ink-soft);
    word-break: break-word;
  }

  .way__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgb(184 147 78 / 0.18);
  }

  .way__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  /* A live dot. Small, but it is what makes a card read as something running
     rather than something printed. */
  .way__status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px rgb(63 118 82 / 0.14);
  }

  @media (prefers-reduced-motion: no-preference) {
    .way__status i { animation: dot-breathe 2.6s ease-in-out infinite; }
  }
  @keyframes dot-breathe {
    0%, 100% { opacity: 0.55; box-shadow: 0 0 0 2px rgb(63 118 82 / 0.1); }
    50%      { opacity: 1;    box-shadow: 0 0 0 5px rgb(63 118 82 / 0.16); }
  }

  .way__arrow {
    width: 20px;
    height: 10px;
    flex: none;
    color: var(--leaf-text);
    transition: transform 0.5s var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .way:hover { transform: translateY(-5px); box-shadow: 0 22px 50px rgb(43 38 34 / 0.11); }
    .way:hover .way__label { color: var(--leaf-text); }
    .way:hover .way__arrow { transform: translateX(5px); }
    .way:hover .way__well { box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.45), 0 8px 20px rgb(63 118 82 / 0.16); }
  }

  /* --- Responsive --------------------------------------------------------- */

  @media (max-width: 900px) {
    .hero__inner, .form__wrap { grid-template-columns: 1fr; }
    .hero__orb { order: -1; max-width: 22rem; justify-self: center; width: 100%; }
  }

  @media (max-width: 520px) {
    .form__row { grid-template-columns: 1fr; }
  }
</style>
