---
import { getImage } from 'astro:assets';
import { url } from '../lib/site';
import type { Locale } from '../i18n/locales';
import motionPoster from '../assets/film-in-motion.webp';
import storyPoster from '../assets/film-june-story.webp';
import techniquePoster from '../assets/film-touch-and-technique.webp';
import awardedPoster from '../assets/film-june-awarded-2026.webp';
const { locale = 'de', featured = false } = Astro.props as { locale?: Locale; featured?: boolean };
const text = {
  de: ['LUMA in Bewegung', 'June bei der Arbeit.', 'Einblicke in Junes Arbeit, ihre Erfolge und das, was sie bewegt.', 'Die Kunst der Berührung', 'June erzählt.', '', 'Video abspielen', 'Video öffnen'],
  en: ["LUMA in motion", "Watch June at work.", "June shares her work, her achievements and what inspires her.", "The art of touch", "In June’s own words.", "", "Play video", "Open video"],
  es: ["LUMA en vídeo", "June en acción.", "Conoce su trabajo, sus logros y lo que la motiva.", "El arte del masaje", "June cuenta su historia.", "", "Reproducir vídeo", "Abrir vídeo"],
  pt: ["LUMA em vídeo", "A June em ação.", "Conheça o seu trabalho, as suas conquistas e o que a motiva.", "A arte da massagem", "A June conta a sua história.", "", "Reproduzir vídeo", "Abrir vídeo"],
  it: ["LUMA in video", "June al lavoro.", "Scopri il suo lavoro, i suoi traguardi e ciò che la motiva.", "L’arte del massaggio", "June si racconta.", "", "Riproduci video", "Apri video"],
  fr: ["LUMA en vidéo", "June au travail.", "Découvrez son travail, ses récompenses et ce qui la motive.", "L’art du toucher", "June raconte.", "", "Lire la vidéo", "Ouvrir la vidéo"],
}[locale];
const films = [
  { src: '/media/june-awarded-2026.mp4', poster: (await getImage({src: awardedPoster, width: 720, format: 'webp'})).src, title: {de:'Ausgezeichnet. June 2026.', en:'Awarded. June 2026.', es:'Premiada. June 2026.', pt:'Premiada. June 2026.', it:'Premiata. June 2026.', fr:'Les récompenses de June. 2026.'}[locale], duration:'00:33', width:720, height:1280 },
  { src: '/media/june-in-motion.mp4', poster: (await getImage({src: motionPoster, width: 480, format: 'webp'})).src, title: text[3], duration: '00:14', width:480, height:848 },
  { src: '/media/june-story.mp4', poster: (await getImage({src: storyPoster, width: 720, format: 'webp'})).src, title: text[4], duration: '00:41', width:720, height:1280 },
  { src: '/media/june-touch-and-technique.mp4', poster: (await getImage({src: techniquePoster, width: 480, format: 'webp'})).src, title: {de:'Mit Gefühl. Mit Präzision.', en:'Touch and technique.', es:'Cuidado en cada detalle.', pt:'Cuidado em cada detalhe.', it:'Cura in ogni dettaglio.', fr:'Le geste et la technique.'}[locale], duration:'00:51', width:480, height:848 },
];
// The earlier "passion" upload is an older export of the 2026 award film.
// About already offers that film beside the photograph that won the award.
const selection = featured ? films.filter((film) => ['/media/june-story.mp4', '/media/june-touch-and-technique.mp4'].includes(film.src)) : films;
---
<section class:list={['film-section', 'section', featured ? 'film-section--featured' : 'film-section--collection']} aria-labelledby="film-title">
  <div class="shell film-section__inner">
    <div class="film-section__intro"><p class="eyebrow">{text[0]}</p><h2 id="film-title">{text[1]}</h2><p>{text[2]}</p></div>
    <div class="film-section__films" data-film-track tabindex="0" role="region" aria-label={text[0]}>{selection.map((film, i) => <figure class="film-card">
      <div class="film-card__screen">
        <video controls playsinline preload="none" data-lazy-poster={film.poster} width={film.width} height={film.height} aria-label={film.title} data-film>
          <source src={url(film.src)} type="video/mp4" />
          <a href={url(film.src)}>{text[7]}</a>
        </video>
      </div>
      <figcaption><span class="film-card__number">0{i+1}</span><h3>{film.title}</h3><span>{film.duration}</span></figcaption>
    </figure>)}</div>
  </div>
</section>
