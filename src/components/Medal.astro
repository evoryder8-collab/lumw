---
/** An engraved achievement seal. Original linework, no gradients or plastic bevels. */
interface Props { metal: 'gold' | 'silver' | 'bronze'; size?: number; label?: string; }
const { metal, size = 42, label } = Astro.props;
const rank = { gold: 'I', silver: 'II', bronze: 'III' }[metal];
---
<svg class="medal" width={size} height={size} viewBox="0 0 64 64"
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}
  fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="32" cy="29" r="17" opacity="0.45" />
  <circle cx="32" cy="29" r="13" stroke-dasharray="0.1 3.1" />
  <path d="M26 53C9 48 5 28 16 14M38 53c17-5 21-25 10-39" />
  <path d="M13 20c-5-1-7-4-6-7 5 1 7 3 6 7Zm-3 9c-6-1-8-4-7-8 5 1 8 4 7 8Zm2 10c-6 0-9-3-9-7 6 0 9 3 9 7Zm5 8c-6 2-10 0-11-4 6-2 10 0 11 4Zm7 6c-5 3-9 2-11-2 5-3 9-2 11 2Z" />
  <path d="M51 20c5-1 7-4 6-7-5 1-7 3-6 7Zm3 9c6-1 8-4 7-8-5 1-8 4-7 8Zm-2 10c6 0 9-3 9-7-6 0-9 3-9 7Zm-5 8c6 2 10 0 11-4-6-2-10 0-11 4Zm-7 6c5 3 9 2 11-2-5-3-9-2-11 2Z" />
  <path d="m29 5 3-3 3 3M29 57l3 3 3-3" opacity="0.7" />
  <text x="32" y="34.5" fill="currentColor" stroke="none" text-anchor="middle" font-family="Georgia, serif" font-size="16">{rank}</text>
</svg>
<style>.medal { display: block; flex: none; color: var(--gold-text); }</style>
