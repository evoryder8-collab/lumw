---
import { Image } from 'astro:assets';
import gold from '../assets/medals/gold.png';
import silver from '../assets/medals/silver.png';
import bronze from '../assets/medals/bronze.png';

interface Props { metal: 'gold' | 'silver' | 'bronze'; size?: number; label?: string; }
const { metal, size = 64, label } = Astro.props;
const artwork = { gold, silver, bronze }[metal];
---
<Image class="medal" src={artwork} width={224} height={224} format="webp" quality={85}
  alt={label ?? ''} aria-hidden={label ? undefined : 'true'} loading="lazy"
  style={`--medal-size:${size}px`} />
<style>
  .medal { display: block; flex: none; width: var(--medal-size); height: var(--medal-size); object-fit: contain; filter: drop-shadow(0 5px 4px rgb(0 0 0 / 0.2)); }
</style>
