---
import { getImage } from 'astro:assets';
import type { Locale } from '../i18n/locales';
import logoArt from '../assets/logo-luma-full.webp';
// June's official logo, risen from the lotus on the closed curtain. Fetched only
// when the curtain is prepared, never during page load.
const logo = await getImage({ src: logoArt, width: 900, format: 'webp', quality: 86 });
const { locale = 'de', mode = 'welcome' } = Astro.props as { locale?: Locale; mode?: 'welcome' | 'page' };
const pageTransition = mode === 'page';
const Tag = pageTransition ? 'div' : 'dialog';
const label = { de: 'Willkommen bei LUMA', en: 'Welcome to LUMA', es: 'Bienvenido a LUMA', pt: 'Bem-vindo à LUMA', it: 'Benvenuto da LUMA', fr: 'Bienvenue chez LUMA' }[locale];
---
<!-- The velvet itself is drawn by a lazily loaded shader (curtain-velvet.ts).
     Until its first frame, the host shows a closed curtain in plain CSS. -->
<Tag class:list={['welcome-curtain', pageTransition && 'page-curtain']} data-welcome-curtain={pageTransition ? undefined : ''} data-page-curtain={pageTransition ? '' : undefined} data-petals={pageTransition ? 14 : 34} data-curtain={pageTransition ? 'page' : 'welcome'} data-logo={logo.src} aria-label={pageTransition ? undefined : label} aria-hidden={pageTransition ? 'true' : undefined} hidden={pageTransition} transition:persist={pageTransition ? 'luma-page-curtain' : undefined}></Tag>
<style>
  .welcome-curtain {
    position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none;
    padding: 0; border: 0; overflow: hidden; background: transparent;
  }
  /* The welcome starts closed, so until the shader's first frame it shows a
     closed curtain in plain CSS: folds and a seam of light. Page transitions
     start open and need no stand-in. */
  .welcome-curtain:not(.page-curtain) {
    background:
      radial-gradient(ellipse 9% 70% at 50% 46%, rgb(255 236 190 / 0.18), transparent 70%),
      linear-gradient(90deg, transparent calc(50% - 9px), #b8934e calc(50% - 9px), #e9d29c calc(50% - 3px), #6f5424 50%, #e9d29c calc(50% + 3px), #b8934e calc(50% + 9px), transparent calc(50% + 9px)),
      radial-gradient(ellipse 80% 60% at 50% 30%, rgb(110 150 120 / 0.28), transparent 70%),
      repeating-linear-gradient(90deg, #0b241c 0, #1d4636 3.2vw, #12352a 5.4vw, #0b241c 7.1vw),
      #10302a;
  }
  .welcome-curtain::backdrop { background: transparent; }
  .welcome-curtain.is-velvet, .welcome-curtain.is-flat { background: transparent; }
  .page-curtain { z-index: 10000; pointer-events: none; }
  .page-curtain[hidden] { display: none; }
  .welcome-curtain :global(.velvet) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .welcome-curtain :global(.velvet-flat) {
    position: absolute; top: 0; bottom: 0; width: 50.5%; will-change: transform;
    background: repeating-linear-gradient(90deg, #0b241c 0, #1d4636 3.2vw, #12352a 5.4vw, #0b241c 7.1vw);
    box-shadow: 0 0 40px rgb(255 236 190 / 0.25);
  }
  .welcome-curtain :global(.velvet-flat--left) { left: 0; border-right: 6px solid #c9a962; }
  .welcome-curtain :global(.velvet-flat--right) { right: 0; border-left: 6px solid #c9a962; }
  @media (prefers-reduced-motion: reduce) { .welcome-curtain { display: none; } }
</style>
