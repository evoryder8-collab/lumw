---
import { AVAILABLE, routePath } from '../i18n/locales';
import { url } from '../lib/site';
const bioRoutes = Object.fromEntries(AVAILABLE.map(code => [code, url(routePath('bio', code))]));
---
<!-- Choose the static translation before the page and its video initialise.
     Explicit locale URLs always stay in the language their visitor chose. -->
<script is:inline define:vars={{ bioRoutes }} data-astro-rerun>
  (() => {
    if (location.pathname.replace(/\/$/, '') !== bioRoutes.de) return;
    const requested = new URLSearchParams(location.search).get('lang');
    let saved;
    try { saved = sessionStorage.getItem('luma-bio-language'); } catch {}
    const primary = (navigator.languages?.[0] || navigator.language || 'en').toLowerCase().split(/[-_]/)[0];
    const supported = value => Object.prototype.hasOwnProperty.call(bioRoutes, value);
    const chosen = supported(requested) ? requested : supported(saved) ? saved : supported(primary) ? primary : 'en';
    if (chosen === 'de') return;
    const destination = new URL(bioRoutes[chosen], location.origin);
    destination.search = location.search;
    destination.hash = location.hash;
    location.replace(destination.href);
  })();
</script>
