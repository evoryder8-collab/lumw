---
import symbol from '../assets/logo-luma-symbol-display.webp';
const { class: className = '' } = Astro.props as { class?: string };
---
<span class:list={['brand-symbol', className]} aria-hidden="true">
  <img src={symbol.src} width={symbol.width} height={symbol.height} alt="" decoding="async" />
</span>

<style>
  /* Frame the original artwork's ink bounds, without changing its shape. */
  .brand-symbol {
    position: relative;
    display: inline-block;
    flex: none;
    width: 48px;
    height: 58px;
    overflow: hidden;
    border: 1px solid #c7b484;
    border-radius: 16px;
    background: linear-gradient(145deg, #fffffc, #e9e7d9);
    box-shadow: inset 0 1px 1px #fff, inset 0 -2px 3px #baa76d33, 0 3px 9px #0a211c24;
  }
  .brand-symbol img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 215%;
    height: auto;
    max-width: none;
    transform: translate(-51%, -44.7%);
    filter: drop-shadow(0 0.35px 0.3px #795e3880);
  }
</style>
