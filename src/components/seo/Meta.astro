---
/**
 * Titles, descriptions and canonicals are copied exactly from the live site at
 * cutover. No creative rewrites: never change URL and title in the same release
 * (CLAUDE.md section 7).
 *
 * Canonicals carry no trailing slash because the live Wix URLs carry none, and
 * the canonical is the strongest identifier Google holds for these pages.
 *
 * noindex defaults to ON. Section 7 step 1 says staging is built noindex and
 * step 5 removes it in the cutover release, so shipping it the other way round
 * would risk indexing the staging build. Flip with PUBLIC_INDEXABLE=true.
 */
import { SITE_URL } from '../../lib/site';
import { localeForPath, routeKeyForPath, alternatesFor } from '../../i18n/locales';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  /**
   * Keep this page out of the index even in a production build. For pages that
   * are never a destination - the 404 - where a soft 404 that Google indexes
   * would be worse than the hard one it replaces.
   */
  noindex?: boolean;
}

const { title, description, path, ogImage, ogType = 'website', noindex = false } = Astro.props;

const canonical = `${SITE_URL}${path === '/' ? '/' : path}`;
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !noindex;
const image = ogImage ? new URL(ogImage, SITE_URL).href : undefined;
const locale = localeForPath(path);
const ogLocale = { de: 'de_DE', en: 'en_GB', th: 'th_TH', es: 'es_ES', pt: 'pt_PT', it: 'it_IT' }[locale];
const key = routeKeyForPath(path);
const alternates = key ? alternatesFor(key) : [];
---

<title>{title}</title>
<meta name="description" content={description} />
<!-- Preserve the existing Wix property's ownership verification at cutover. -->
<meta name="google-site-verification" content="OSbPqjHPC8B-5LSnAuVPZw-8I2HVK0zDGEjJE7L0VBk" />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.tag} href={`${SITE_URL}${a.path}`} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${alternates[0].path}`} />}

{
  indexable ? (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  ) : (
    <meta name="robots" content="noindex, nofollow" />
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="LUMA WELLNESS by June Saurin" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image} />}
{image && <meta property="og:image:alt" content={title} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}

<meta name="geo.region" content="DE-NI" />
<meta name="geo.placename" content="Buxtehude" />
