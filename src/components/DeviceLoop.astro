---
import type { Locale } from '../i18n/locales';
import copy from '../i18n/face-care.json';
import { url } from '../lib/site';
const { locale = 'de', kind = 'action' } = Astro.props as { locale?: Locale; kind?: 'action' | 'echogram' };
const c = copy[locale];
const alt = kind === 'action' ? c.actionAlt : c.echoAlt;
const source = url(`/media/corefit/face-player-${kind}.mp4`);
const poster = url(`/media/corefit/${kind === 'action' ? 'action' : 'echogram'}-poster.webp`);
---
<div class:list={['device-loop', `device-loop--${kind}`]} data-device-loop>
  <video data-device-video autoplay muted loop playsinline preload="none" aria-label={alt} data-device-src={source} data-device-poster={poster}>
    <a href={source}>{c.play}</a>
  </video>
  <noscript>
    <style is:inline>.device-loop > [data-device-video] { display: none; }</style>
    <video autoplay muted loop playsinline preload="none" {poster} aria-label={alt} src={source}></video>
  </noscript>
  <button class="device-loop__toggle" type="button" data-device-toggle data-play={c.play} data-pause={c.pause} aria-label={c.play} hidden><span data-device-toggle-symbol aria-hidden="true">Ⅱ</span><span class="sr-only" data-device-toggle-label>{c.play}</span></button>
</div>
