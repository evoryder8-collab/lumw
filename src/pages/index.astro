---
/**
 * Home. Copy verbatim from the live page; title, description and H1 unchanged.
 *
 * Chapter order follows section 9.2: dawn hero, credibility strip, service
 * chapters, June, testimonial, booking, closing loop. Motion arrives in stage 6
 * on this same structure.
 */
import { getCollection } from 'astro:content';
import Photo from '../components/Photo.astro';
import { heroPreload } from '../lib/heroPreload';
import { socialImageUrl } from '../lib/images';
import Layout from '../layouts/Layout.astro';
import AwardStrip from '../components/AwardStrip.astro';
import { BUSINESS, url, treatmentName } from '../lib/site';
import {
  graph, businessNode, personNode, websiteNode, webPageNode,
} from '../lib/schema';

import junePortrait from '../assets/june-portrait.webp';
import studioWorking from '../assets/studio-june-working.webp';
import studioExterior from '../assets/studio-exterior-hautnah.webp';
/* The chapters run full-bleed at 100vw by 100svh, which is where the baked
   vignettes on these files hurt most: a transparent edge over a viewport-sized
   element lets the page through, so the photograph stops short of the edges it
   is meant to own. june-with-nadine-stark, at a mean alpha of 0.146, was a
   small blob adrift in a whole screen. These are the opaque 16:9 crops from
   scripts/normalize-cards.mjs. */
import imgAroma from '../assets/chapter/treatment-back-warm.webp';
import imgGold from '../assets/chapter/award-competition-gold.webp';
import imgThai from '../assets/chapter/award-competition-stretch.webp';
import imgPregnancy from '../assets/chapter/treatment-pregnancy.webp';
import imgStark from '../assets/chapter/june-with-nadine-stark.webp';
import imgFacial from '../assets/chapter/treatment-facial.webp';

const title =
  'Massage Buxtehude – LUMA Wellness by June Saurin | Goldprämierte Massagen & Wellness';
const description =
  'Massage in Buxtehude bei LUMA Wellness – internationale Goldmedaillen-Massagen & ganzheitliche Entspannung in Hauptstraße 19. Jetzt Termin sichern & Wohlbefinden steigern!';
const path = '/';

// Chapter 3 of the scroll narrative. Same six items and the same verbatim copy
// as the live page; the presentation becomes a pinned chapter per treatment.
const angebote = [
  {
    image: imgAroma,
    alt: 'Aroma-Luxus Massage mit Bio-Jojoba-Ölen bei LUMA Wellness in Buxtehude',
    name: 'LUMA Aroma-Luxus Massage (Klassiker)',
    text: 'Diese einzigartige Massage kombiniert die bewährten Techniken der klassischen Massage mit den therapeutischen Eigenschaften von Bio-Aromatherapie-Ölen.',
  },
  {
    image: imgGold,
    alt: 'June Saurin bei der goldprämierten Gold-Medalie Massage',
    name: 'LUMA Gold-Medalie Signature Massage',
    text: 'Eine exklusive Massage, die preisgekrönte Techniken aus internationalen Wettbewerben vereint und durch eine maßgeschneiderte Klanglandschaft ergänzt wird. Die LUMA Gold-Medalie Signature Massage kombiniert Elemente aus verschiedenen Massagestilen, individuell auf Ihre Bedürfnisse abgestimmt, und entführt Sie mit beruhigender Musik und Naturklängen in eine Welt tiefster Entspannung. Ideal für alle, die ein einzigartiges, luxuriöses Wellness-Erlebnis suchen, das Körper und Geist harmonisch in Einklang bringt.',
  },
  {
    image: imgThai,
    alt: 'June Saurin bei einer thailändischen Dehnungstechnik',
    name: 'LUMA THAI-Solution Massage (Nuad-Benja-Phaki)',
    text: 'Traditionelle thailändische Techniken zur Verbesserung der Beweglichkeit und des Energieflusses. Diese Massageform kombiniert sanfte Dehnungen mit Druckpunkttherapie, um Verspannungen zu lösen und die Flexibilität zu erhöhen.',
  },
  {
    image: imgPregnancy,
    alt: 'Sanfte Schwangerschaftsmassage für werdende Mütter',
    name: 'LUMA Schwangerschaftsmassage',
    text: 'Sanfte, sichere Techniken zur Linderung von Schwangerschaftsbeschwerden. Diese speziell entwickelte Massage unterstützt werdende Mütter dabei, Schmerzen zu reduzieren, Stress abzubauen und das allgemeine Wohlbefinden zu steigern.',
  },
  {
    image: imgStark,
    alt: 'June Saurin mit Weltmeisterin Nadine Stark Chognon',
    name: 'STARK BALL MASSAGE / Sportmassage',
    text: 'Speziell für Athleten und körperlich aktive Personen zur Verbesserung der Flexibilität und zur Vorbeugung von Verletzungen. Diese Massage hilft, Muskelverspannungen zu lösen, die Regeneration zu fördern und die Leistungsfähigkeit zu steigern.',
  },
  {
    image: imgFacial,
    alt: 'Gesichts- und Kopfmassage inklusive Gua Sha',
    name: 'Gesichts- und Kopfmassage inkl. Gua Sha',
    text: 'Verjüngende Massagen, die die Haut straffen, die Durchblutung fördern und für ein erfrischtes Erscheinungsbild sorgen.',
  },
];

const heroSizes = '(max-width: 900px) 100vw, 40vw';
const preloadImage = await heroPreload(junePortrait, [480, 720, 900, 1100], heroSizes);

const ogImage = await socialImageUrl(junePortrait, Astro.site);

/**
 * The catalogue on the business node.
 *
 * Read from the treatments collection rather than the six curated chapters
 * above, because the catalogue should describe everything June sells, not the
 * subset this page chose to illustrate. Same source the prices page renders
 * from, so a price can never be advertised here that the site does not show.
 * "From" is the cheapest duration, which is how a price list reads.
 */
const catalog = (await getCollection('treatments'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => ({
    name: treatmentName(t.data.name),
    fromEur: Math.min(...t.data.prices.map((pr) => pr.priceEur)),
    url: new URL(url('/meineangebote-preise'), Astro.site).href,
  }));

const schema = graph([
  businessNode([
    await socialImageUrl(junePortrait, Astro.site),
    await socialImageUrl(studioWorking, Astro.site),
    await socialImageUrl(studioExterior, Astro.site),
  ], catalog),
  personNode(await socialImageUrl(junePortrait, Astro.site)),
  websiteNode(),
  webPageNode({ title, description, path, imageUrl: await socialImageUrl(junePortrait, Astro.site) }),
]);
---

<Layout {title} {description} {path} schema={schema} {ogImage} {preloadImage}>
  <!-- Chapter 1. Dawn hero. The page breathes before the user moves. -->
  <section class="hero">
    <!-- Light motes. Hero and closing chapter only, paused offscreen. -->
    <canvas class="motes" aria-hidden="true"></canvas>

    <div class="shell hero__inner">
      <div class="hero__copy">
        <p class="eyebrow" data-fade>Weltweit ausgezeichnete Massage</p>
        <h1 class="hero__title" data-reveal>Beste Massage in Buxtehude</h1>
        <p class="hero__sub" data-fade>
          LUMA Wellness by June Saurin, Ihre ausgezeichnete Therapeutin.
        </p>
        <div class="hero__actions" data-fade>
          <a href={url('/contact')} class="pill sheen halo" data-magnetic>
            <span data-magnetic-label>Buchen Sie eine Massage</span>
          </a>
          <a href={url('/meineangebote-preise')} class="underline-gold hero__ghost">
            Alle Angebote &amp; Preise
          </a>
        </div>
      </div>

      <figure class="hero__figure float float--slow bleed" data-drift>
        <Photo
          src={junePortrait}
          alt="June Saurin, international ausgezeichnete Massagetherapeutin bei LUMA Wellness in Buxtehude"
          widths={[480, 720, 900, 1100]}
          sizes={heroSizes}
          ratio="4 / 5"
          priority
        />
      </figure>
    </div>
  </section>

  <!-- Chapter 2. Credibility strip. -->
  <AwardStrip />

  <!-- Chapter 3. Intro. -->
  <section class="section">
    <div class="shell shell--mid">
      <h2 class="section__title" data-reveal>
        Grosse Wirkung, kleiner Körper – erleben Sie LUMA Wellness in Buxtehude
      </h2>
      <div class="prose intro__body" data-fade>
        <p>
          Trotz meines zierlichen Körpers übertreffe ich sämtliche Erwartungen mit Kraft und
          Geschicklichkeit. Schon nach einer einzigen Sitzung spüren Sie die Qualität meiner Arbeit
          und erleben positive Effekte. Mit einer Vielfalt an Techniken und Werkzeugen erschaffe ich
          ein maßgeschneidertes Massageerlebnis, das Körper und Geist gleichermaßen anspricht.
        </p>
        <p>
          Ich, June Saurin, bringe unermüdliche Entschlossenheit und ein tiefes Herz für
          ganzheitliche Massagen nach Buxtehude. Diese Passion bescherte mir ein erfülltes Leben
          voller Erfolge und höchster Kundenzufriedenheit.
        </p>
        <p class="intro__link">
          <a href={url('/meineangebote-preise')} class="underline-gold">Alle Angebote &amp; Preise</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Chapter 4. Ganzheitliche Massagen, against the studio photograph. -->
  <section class="section holistic" data-sunbeam>
    <div class="shell holistic__inner">
      <figure class="holistic__figure float float--slow bleed" data-drift>
        <Photo
          src={studioWorking}
          alt="June Saurin bei einer ganzheitlichen Massage im LUMA Wellness Studio in Buxtehude"
          widths={[520, 760, 1040]}
          sizes="(max-width: 900px) 88vw, 48vw"
          ratio="5 / 4"
        />
      </figure>

      <div class="holistic__copy">
        <p class="eyebrow" data-fade>Wohlbefinden ist mehr als nur äusserlich</p>
        <h2 data-reveal>Ganzheitliche Massagen in Buxtehude</h2>
        <div class="prose" data-fade>
          <p>
            Wohlbefinden geht über die rein physische Ebene hinaus. Bei LUMA Wellness by June Saurin in
            Buxtehude ist sie nicht nur mit wissenschaftlicher und medizinischer Expertise verknüpft,
            sondern kann auch spirituell von innen heraus erwachen. Ein gesunder Geist funktioniert
            optimal in einem gesunden Körper – genau das fördern meine Massagen: tiefgreifende
            körperliche Entspannung und geistiges Wohlbefinden. Durch die Kombination traditioneller
            thailändischer Techniken mit modernen Wellnessansätzen schaffe ich eine harmonische
            Balance, die Ihnen hilft, Stress abzubauen und Ihre innere Energie wiederzuentdecken.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 5. Angebotsübersicht. -->
  <section class="section">
    <div class="shell">
      <h2 class="section__title section__title--center" data-reveal>
        Meine Massage und Wellnessangebote in Buxtehude
      </h2>
    </div>

    <!-- Names the chapter you are inside while the pinned sequence runs. -->
    <div class="chapter-counter" data-chapter-counter aria-hidden="true">
      <span data-chapter-now>01</span>
      <span class="chapter-counter__rule"></span>
      <span data-chapter-total>06</span>
    </div>

    <!-- Chapter 3. Each treatment pins for one viewport. The photograph is the
         chapter, edge to edge and full height, scaling down through the pin so
         the scene settles as you read it. Same grammar every chapter, so the
         rhythm becomes the identity. -->
    {
      angebote.map((a, i) => (
        <div class="chapter" data-chapter>
          <figure class="chapter__media" data-chapter-media data-drift>
            <Photo
              src={a.image}
              alt={a.alt}
              widths={[900, 1400, 1920]}
              sizes="100vw"
              variant="fill"
              priority={i === 0}
            />
          </figure>

          {/* Porcelain poured across the side the copy sits on, so ink reads at
              full contrast over any frame without dimming the picture itself. */}
          <span class="chapter__scrim" aria-hidden="true"></span>

          <div class="shell chapter__inner">
            <div class="chapter__copy" data-chapter-copy>
              <p class="chapter__num">{String(i + 1).padStart(2, '0')} / 06</p>
              <h3 class="chapter__name">{a.name}</h3>
              <p class="chapter__text">{a.text}</p>
              <p class="chapter__cta" data-chapter-price>
                <a href={url('/meineangebote-preise')} class="underline-gold">
                  Preise ansehen
                </a>
              </p>
            </div>
          </div>
        </div>
      ))
    }

    <div class="shell">
      <div class="offers__foot">
        <p>
          <a href={url('/meineangebote-preise')} class="underline-gold">
            Komplette Liste der Massage-Dienstleistungen hier.
          </a>
        </p>
        <p class="offers__cta-text">
          Kontaktieren Sie mich noch heute, um Ihren Termin zu buchen und die besten Massagen in
          Buxtehude zu erleben!
        </p>
        <a href={url('/contact')} class="pill sheen" data-magnetic>
          <span data-magnetic-label>Buchen Sie eine Massage</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Chapter 6. Hours and location. -->
  <section class="section hours" data-sunbeam>
    <div class="shell hours__inner">
      <div class="hours__col panel float">
        <p class="eyebrow">Termine</p>
        <p class="hours__appointment">Termine nur nach vorheriger Absprache</p>
        <p class="hours__note">
          Schreiben Sie mir per WhatsApp oder rufen Sie an, und wir finden einen
          passenden Termin.
        </p>
      </div>

      <div class="hours__col panel float">
        <p class="eyebrow">Standort</p>
        <p class="hours__address">Hauptstrasse 19, 21614 Buxtehude DE</p>
        <p class="hours__note">
          *Bitte beachten Sie, dass sich mein Studio in der Filiale HAUTNAH befindet, wie auf dem
          Außenbild unten zu sehen ist.
        </p>
        <p class="hours__contact">
          <a href={`tel:${BUSINESS.phoneE164}`} class="underline-gold">{BUSINESS.phone}</a>
          <a href={`mailto:${BUSINESS.email}`} class="underline-gold">{BUSINESS.email}</a>
        </p>
      </div>

      <figure class="hours__figure float float--slow bleed" data-drift>
        <Photo
          src={studioExterior}
          alt="Das LUMA Wellness Studio in der Filiale HAUTNAH, Hauptstraße 19 in Buxtehude"
          widths={[520, 800, 1100]}
          sizes="(max-width: 900px) 92vw, 62vw"
          ratio="16 / 9"
        />
      </figure>
    </div>
  </section>

  <!-- Chapter 7. Closing loop. The dawn motif returns behind the final CTA. -->
  <!-- Chapter 7. The dawn wash and the motes from chapter 1 return behind the
       final CTA. Same motif, same line. -->
  <section class="section close">
    <canvas class="motes" aria-hidden="true"></canvas>

    <div class="shell shell--narrow close__inner">
      <p class="eyebrow" data-fade>LUMA Wellness by June Saurin</p>
      <h2 class="close__title" data-reveal>Beste Massage in Buxtehude</h2>
      <p class="lede close__lede" data-fade>Termine nur nach vorheriger Absprache.</p>
      <a href={url('/contact')} class="pill sheen halo" data-magnetic>
        <span data-magnetic-label>Buchen Sie eine Massage</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* --- Hero ------------------------------------------------------------- */

  .hero { position: relative; }
  .hero .motes, .close .motes { z-index: 0; }
  .hero__inner, .close__inner { position: relative; z-index: 1; }

  .hero {
    display: flex;
    align-items: center;
    min-height: min(88svh, 900px);
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .hero__title {
    /* One light display line in ink. The luxury signal is very large, very
       light type with enormous whitespace. */
    font-size: var(--step-display);
    line-height: 0.98;
    max-width: 12ch;
  }

  .hero__sub {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 34ch;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .hero__ghost { font-size: var(--step-small); color: var(--ink-soft); }

  .hero__figure { margin: 0; }

  /* --- Sections ---------------------------------------------------------- */

  .section__title { max-width: 20ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section__title--center { max-width: 24ch; margin-inline: auto; text-align: center; }

  .intro__body { max-width: 62ch; }
  .intro__link { margin-top: 2rem; }

  /* --- Holistic ---------------------------------------------------------- */

  .holistic__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .holistic__figure { margin: 0; }
  .holistic__copy h2 { margin-bottom: 1.5rem; }

  /* --- Chapter counter --------------------------------------------------- */

  .chapter-counter {
    position: fixed;
    z-index: 40;
    right: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--gold-text);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .chapter-counter.is-visible { opacity: 1; }
  .chapter-counter__rule { width: 1px; height: 2rem; background: rgb(184 147 78 / 0.42); }

  @media (max-width: 900px) {
    .chapter-counter { right: 0.65rem; font-size: 0.625rem; }
    .chapter-counter__rule { height: 1.4rem; }
  }

  @media (prefers-reduced-motion: reduce) { .chapter-counter { display: none; } }

  /* --- Pinned chapters --------------------------------------------------- */
  /* Each chapter is a full-bleed scene: the photograph covers the viewport and
     scales down through the pin, and the copy sits on porcelain poured across
     one side of it. Reserves its full height up front so pinning never shifts
     layout - CLS budget is 0.02 and pins are the usual way that gets blown. */

  .chapter {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .chapter__media {
    position: absolute;
    inset: 0;
    margin: 0;
    z-index: 0;
    will-change: clip-path;
  }
  .chapter__media :global(img) { will-change: transform; }

  /* Porcelain from the left, clearing by two thirds so the picture is never
     dimmed as a whole - only the part carrying words. */
  .chapter__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(96deg,
        var(--porcelain) 0%,
        rgb(253 251 250 / 0.96) 26%,
        rgb(253 251 250 / 0.72) 42%,
        rgb(253 251 250 / 0.18) 58%,
        transparent 72%),
      linear-gradient(to top, rgb(253 251 250 / 0.5), transparent 34%);
  }

  .chapter__inner { position: relative; z-index: 2; width: 100%; }

  .chapter__copy { max-width: 34rem; }

  .chapter__num {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    color: var(--gold-text);
    margin: 0 0 1rem;
  }

  .chapter__name {
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    line-height: 1.04;
    margin-bottom: 1.35rem;
    max-width: 15ch;
  }

  .chapter__text {
    color: var(--ink-soft);
    max-width: 46ch;
    font-size: clamp(1rem, 1.35vw, 1.12rem);
  }

  .chapter__cta { margin-top: 1.85rem; font-size: var(--step-small); }

  /* --- Hours ------------------------------------------------------------- */

  .hours__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .hours__col { padding: clamp(1.75rem, 3vw, 2.5rem); }

  .hours__appointment {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.28;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }

  .hours__address {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .hours__note {
    font-size: 0.875rem;
    color: var(--ink-mute);
    font-style: italic;
    line-height: 1.55;
  }

  .hours__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1.25rem;
    font-size: var(--step-small);
  }

  .hours__figure { grid-column: 1 / -1; margin: 0; }

  /* --- Closing loop ------------------------------------------------------ */

  .close__inner { display: grid; justify-items: center; text-align: center; gap: 1.5rem; }
  .close__title { max-width: 14ch; }
  .close__lede { margin: 0; }

  /* --- Responsive -------------------------------------------------------- */

  @media (max-width: 900px) {
    .hero__inner,
    .holistic__inner,
    .chapter__inner,
    .hours__inner { grid-template-columns: 1fr; }

    .hero__inner { gap: 2rem; }

    /* max-width on a stretched grid item aligns it to the start, which is why
       the hero photograph sat off to the left on wider phones. */
    .hero__figure { order: -1; max-width: 24rem; justify-self: center; width: 100%; }
    .hero__title { max-width: none; }
    .holistic__figure { order: -1; justify-self: center; width: 100%; }

    /* Chapters stay pinned on mobile at a 60vh distance (section 9.4), so each
       one is composed as a full screen: photograph above, copy beneath, no
       drifting apart into two unrelated blocks. */
    /* On a phone the scrim runs bottom-up instead of left-in, and the copy
       sits in the lower third where a thumb already is. */
    .chapter { align-items: flex-end; }

    .chapter__scrim {
      background:
        linear-gradient(to top,
          var(--porcelain) 0%,
          rgb(253 251 250 / 0.97) 28%,
          rgb(253 251 250 / 0.74) 44%,
          rgb(253 251 250 / 0.2) 62%,
          transparent 78%);
    }

    .chapter__inner { padding-bottom: clamp(2.5rem, 8vw, 4rem); }
    .chapter__copy { max-width: none; }
    .chapter__name { max-width: none; font-size: clamp(1.75rem, 8vw, 2.4rem); }
    .chapter__text { font-size: 0.95rem; line-height: 1.6; }

    .hours__figure { justify-self: center; width: 100%; }
  }

  /* On the smallest screens the photograph gives up height so the name and the
     full paragraph both fit. Clamping the copy was worse: it cut sentences off
     mid-word, which reads as broken rather than concise. */
  @media (max-width: 430px) {
    .chapter__text { font-size: 0.9rem; line-height: 1.55; }
  }

</style>
