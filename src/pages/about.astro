---
/**
 * Owner-approved editorial revision, 18 September 2026.
 * Original title and description retained for continuity after migration.
 *
 * This is the E-E-A-T page. The award record is rendered as text and marked up
 * in Person.award, and the competition photographs are the evidence.
 */
import { socialImageUrl } from '../lib/images';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import AwardRecord from '../components/AwardRecord.astro';
import PhotoAward from '../components/PhotoAward.astro';
import FilmSection from '../components/FilmSection.astro';
import PenzbergPhoto from '../components/PenzbergPhoto.astro';
import { heroPreload } from '../lib/heroPreload';
import { url } from '../lib/site';
import {
  graph, businessNode, personNode, websiteNode, webPageNode, breadcrumbNode,
} from '../lib/schema';

import junePortrait from '../assets/june-dark-portrait.webp';
/* Cropped to the shapes this page renders them at, and flattened, by
   scripts/normalize-cards.mjs. The originals are portraits carrying a baked
   vignette, and a portrait cover-cropped into a 3:2 plate keeps a narrow band
   of itself with the subject floating small in a white surround. */
import awardCertificate from '../assets/about/award-certificate.webp';
import awardTrophies from '../assets/about/award-trophies.webp';
import competitionStage from '../assets/about/award-competition-stage.webp';
import withNadine from '../assets/about/june-with-nadine-stark.webp';

const title = 'UBER MICH | LUMA Wellness';
const description =
  'Erfahren Sie mehr über June Saurin, Gründerin von LUMA Wellness in Buxtehude. Spezialistin für professionelle Massagen und ganzheitliche Entspannung.';
const path = '/about';

const heroSizes = '(max-width: 900px) 76vw, 38vw';
const preloadImage = await heroPreload(junePortrait, [400, 600, 860], heroSizes);


const schema = graph([
  businessNode(),
  personNode(await socialImageUrl(junePortrait, Astro.site)),
  websiteNode(),
  webPageNode({
    title, description, path,
    imageUrl: await socialImageUrl(junePortrait, Astro.site),
    hasBreadcrumb: true,
  }),
  breadcrumbNode(path, [
    { name: 'Startseite', path: '/' },
    { name: 'UBER MICH', path: '/about' },
  ]),
]);
---

<Layout {title} {description} {path} schema={schema} ogType="profile" {preloadImage}>
  <section class="hero">
    <div class="shell hero__inner">
      <div>
        <p class="eyebrow">June Saurin · Gründerin von LUMA</p>
        <h1 data-reveal>Über June</h1>
        <p class="lede hero__lede" data-fade>
          In Thailand aufgewachsen, international ausgezeichnet und in Buxtehude für Sie da.
        </p>
      </div>

      <figure class="hero__figure float float--slow" data-drift>
        <Photo
          src={junePortrait}
          alt="Porträt von June Saurin, Gründerin von LUMA Wellness in Buxtehude"
          widths={[400, 600, 860]}
          sizes={heroSizes}
          ratio="4 / 5"
          priority
        />
      </figure>
    </div>
  </section>

  <section class="section--tight">
    <div class="shell shell--mid">
      <div class="prose story" data-fade>
        <p>
          June wurde in Thailand geboren und wuchs in der Nähe erfahrener Massagefachkräfte auf. Dort lernte sie früh die Arbeit mit Berührung und Bewegung kennen.
        </p>
        <p>
          2023 gewann June Silber in Freestyle Eastern bei der Schweizer Massage-Meisterschaft in Zürich und Silber in Wellness &amp; Spa beim Wettbewerb der World Massage Federation in Athen. Im selben Jahr erreichte sie das Finale der Damen-Division des M1 Massage Gala Battles.
        </p>
      </div>
    </div>
  </section>

  <!-- The record, rendered as text as well as marked up. -->
  <section class="section--tight">
    <div class="shell">
      <div class="record">
        <div class="record__list">
          <h2 class="eyebrow">Auszeichnungen · 2023 bis 2026</h2>
          <AwardRecord />
        </div>

        <figure class="record__figure float float--slow" data-drift>
          <Photo
            src={awardTrophies}
            alt="June Saurin mit ihren Pokalen und Medaillen der internationalen Massage-Meisterschaften 2023"
            widths={[380, 560, 760]}
            sizes="(max-width: 900px) 82vw, 36vw"
            ratio="2 / 3"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="shell shell--mid">
      <div class="prose story" data-fade>
        <p>
          Drei Medaillen in Penzberg: Bei der Universal Massage Championship 2023 gewann June Gold in Wellness &amp; Spa und Silber in Freestyle Eastern. Im Champ of the Champs, der Gesamtwertung gegen die Champions der anderen Massagekategorien, erreichte sie den dritten Platz. Das Gruppenfoto zeigt sie bei der gemeinsamen Feier auf der Bühne.
        </p>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <PenzbergPhoto />
    </div>
  </section>

  <section class="section--tight">
    <div class="shell">
      <div class="gallery">
        <figure>
          <Photo
            src={competitionStage}
            alt="June Saurin im Wettkampf bei einer internationalen Massage-Meisterschaft"
            widths={[380, 620, 900]}
            sizes="(max-width: 760px) 88vw, 32vw"
            ratio="3 / 2"
          />
        </figure>
        <figure>
          <Photo
            src={awardCertificate}
            alt="June Saurin mit ihrer Urkunde und den Medaillen der Massage-Meisterschaft 2023"
            widths={[380, 620, 900]}
            sizes="(max-width: 760px) 88vw, 32vw"
            ratio="3 / 2"
          />
        </figure>
        <figure>
          <Photo
            src={withNadine}
            alt="June Saurin mit Weltmeisterin Nadine Stark Chognon, Entwicklerin der STARK BALL MASSAGE"
            widths={[380, 620, 900]}
            sizes="(max-width: 760px) 88vw, 32vw"
            ratio="3 / 2"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="shell shell--mid">
      <div class="prose story" data-fade>
        <h2>Erfahrung, die in jede Massage einfließt.</h2>
        <p>Bei Wettbewerben lernt June neue Techniken kennen und tauscht sich mit anderen Massagefachkräften aus. Im Studio geht es darum, was Sie brauchen: welche Bereiche massiert werden sollen, welcher Druck angenehm ist und wie Sie sich während der Behandlung fühlen.</p>
        <p>Ob Sie bereits eine bestimmte Massage im Sinn haben oder eine Empfehlung wünschen, June berät Sie persönlich.</p>
      </div>

      <p class="story__cta">
        <a href={url('/contact')} class="pill sheen halo" data-magnetic>
          <span data-magnetic-label>Termin anfragen</span>
        </a>
      </p>
    </div>
  </section>

  <PhotoAward />
  <FilmSection featured />

  <section class="section close">
    <div class="shell shell--narrow close__inner">
      <h2 class="close__title" data-reveal>Lernen wir uns persönlich kennen.</h2>
      <p class="lede">Erzählen Sie June, was Sie sich von Ihrer Massage wünschen.</p>
      <a href={url('/contact')} class="pill sheen">Termin anfragen</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem); }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .hero__lede { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: 32ch; }
  .hero__figure { margin: 0; }

  .story { max-width: 64ch; }
  .story__cta { margin-top: 2.5rem; }

  /* --- The record --- */

  .record {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .record__list ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .record__item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'medal award' 'medal meta';
    align-items: center;
    column-gap: 0.95rem;
    row-gap: 0.2rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid rgb(184 147 78 / 0.16);
  }
  .record__item:last-child { border-bottom: 0; }

  .record__item > :global(.medal) { grid-area: medal; }
  .record__award {
    grid-area: award;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--ink);
  }

  .record__meta {
    grid-area: meta;
    font-size: 0.875rem;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
  }

  .record__figure { margin: 0; }

  /* --- Gallery --- */

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.85rem, 2vw, 1.5rem);
  }
  .gallery figure { margin: 0; }

  /* --- Testimonial. Generous emptiness around it. --- */

  .testimonial { text-align: center; }
  .testimonial__label { margin-bottom: 2rem; }

  .testimonial__quote { margin: 0; }

  .testimonial__quote p {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3.2vw, 2.35rem);
    font-weight: 300;
    line-height: 1.32;
    color: var(--ink);
    max-width: none;
    margin: 0 auto 2rem;
    text-wrap: balance;
  }

  .testimonial__cite {
    font-size: var(--step-small);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  @media (max-width: 900px) {
    .hero__inner, .record { grid-template-columns: 1fr; }
    .hero__figure { order: -1; max-width: 20rem; }
    .record__figure { max-width: 18rem; }
  }

  @media (max-width: 760px) {
    .gallery { grid-template-columns: 1fr; }
  }
</style>
