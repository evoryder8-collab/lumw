---
/**
 * KONTAKT. Verified studio details and the appointment enquiry composer.
 * The page body is shared with the five translations (ContactPage.astro),
 * so every language presents the same sections in the same order.
 *
 * The form posts nowhere yet: the booking backend is stage 5 and lives in
 * Supabase Edge Functions, outside this repo. Until then the form is marked
 * inert and the working routes (phone, WhatsApp, email) are given first, so no
 * visitor is ever led into a dead end. The honeypot and timing fields the spec
 * asks for are already in place for when the endpoint lands.
 */
import { socialImageUrl } from '../lib/images';
import Layout from '../layouts/Layout.astro';
import ContactPage from '../components/ContactPage.astro';
import {
  graph, businessNode, personNode, websiteNode, webPageNode, breadcrumbNode,
} from '../lib/schema';

import studioExterior from '../assets/studio-exterior-hautnah.webp';

const title = 'KONTAKT | LUMA Wellness';
const description =
  'Nehmen Sie Kontakt mit LUMA Wellness by June Saurin in Buxtehude auf. Vereinbaren Sie heute Ihren Termin für professionelle Massagen und ganzheitliche Entspannung!';
const path = '/contact';

const schema = graph([
  businessNode([await socialImageUrl(studioExterior, Astro.site)]),
  personNode(),
  websiteNode(),
  webPageNode({ title, description, path, hasBreadcrumb: true }),
  breadcrumbNode(path, [
    { name: 'Startseite', path: '/' },
    { name: 'KONTAKT', path: '/contact' },
  ]),
]);

---

<Layout {title} {description} {path} schema={schema}>
  <ContactPage />
</Layout>
