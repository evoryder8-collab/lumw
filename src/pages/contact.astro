---
/**
 * KONTAKT. Copy verbatim, including the studio-inside-HAUTNAH note.
 *
 * The form posts nowhere yet: the booking backend is stage 5 and lives in
 * Supabase Edge Functions, outside this repo. Until then the form is marked
 * inert and the working routes (phone, WhatsApp, email) are given first, so no
 * visitor is ever led into a dead end. The honeypot and timing fields the spec
 * asks for are already in place for when the endpoint lands.
 */
import { socialImageUrl } from '../lib/images';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import LocationMap from '../components/LocationMap.astro';
import { BUSINESS, whatsappUrl } from '../lib/site';
import {
  graph, businessNode, personNode, websiteNode, webPageNode, breadcrumbNode,
} from '../lib/schema';

import studioExterior from '../assets/studio-exterior-hautnah.webp';

const title = 'KONTAKT | LUMA Wellness';
const description =
  'Nehmen Sie Kontakt mit LUMA Wellness by June Saurin in Buxtehude auf. Vereinbaren Sie heute Ihren Termin für professionelle Massagen und ganzheitliche Entspannung!';
const path = '/contact';

const schema = graph([
  businessNode([await socialImageUrl(studioExterior, Astro.site)]),
  personNode(),
  websiteNode(),
  webPageNode({ title, description, path, hasBreadcrumb: true }),
  breadcrumbNode(path, [
    { name: 'Startseite', path: '/' },
    { name: 'KONTAKT', path: '/contact' },
  ]),
]);

const waLink = whatsappUrl();
---

<Layout {title} {description} {path} schema={schema}>
  {/* Order: who she is and where, then the map, then the form. The three
      direct channels close the page, because by the time someone has scrolled
      past the form they are choosing how to reach her, not whether to. */}

  <section class="hero">
    <div class="shell hero__inner">
      <div class="hero__copy">
        <p class="eyebrow" data-fade>Kontakt</p>
        <h1 class="hero__title" data-reveal>Kontakt aufnehmen</h1>
        <p class="lede hero__lede" data-fade>
          Ich freue mich darauf, Sie persönlich bei LUMA Wellness by June Saurin in Buxtehude
          begrüßen zu dürfen. Vereinbaren Sie jetzt Ihren Massage-Termin und entdecken Sie
          ganzheitliche Anwendungen, die auf Ihr körperliches und seelisches Wohlbefinden
          ausgerichtet sind.
        </p>
      </div>

      {/* The storefront is a cutout with transparent edges, so it floats as an
          orb rather than sitting in a plate that would draw a white box around
          the empty corners. */}
      <figure class="hero__orb float float--slow" data-drift>
        <span class="hero__orb-halo" aria-hidden="true"></span>
        <Photo
          src={studioExterior}
          alt="Das LUMA Wellness Studio in der Filiale HAUTNAH, Hauptstraße 19 in Buxtehude"
          widths={[480, 760, 1000]}
          sizes="(max-width: 900px) 84vw, 42vw"
          ratio="3 / 2"
          variant="orb"
          priority
        />
      </figure>
    </div>
  </section>

  <div class="shell">
    <LocationMap />
  </div>

  <section class="section" data-sunbeam>
    <div class="shell form__wrap">
      <div class="form__intro">
        <p class="eyebrow" data-fade>Relax. Erfrischen. Wiederbeleben.</p>
        <h2 data-reveal>Schreiben Sie mir</h2>
        <div class="prose form__prose" data-fade>
          <p>
            Wenn ich gerade mit einer Anwendung beschäftigt bin, kann ich Ihren Anruf möglicherweise
            nicht sofort entgegennehmen. Senden Sie mir in diesem Fall einfach eine
            WhatsApp-Nachricht an
            <a href={waLink} class="underline-gold" rel="noopener">+49 178 8875085</a>,
            und ich melde mich schnellstmöglich zurück, um einen passenden Termin mit Ihnen zu
            finden.
          </p>
          <p>
            Alternativ erreichen Sie mich auch gerne per E-Mail an
            <a href={`mailto:${BUSINESS.email}`} class="underline-gold">june@luma-wellness.com</a>
            oder über das untenstehende Kontaktformular auf dieser Webseite. Ich beantworte Ihre
            Anfrage so rasch wie möglich, damit Sie bald die Vorzüge meiner international
            ausgezeichneten Massage-Expertise in Buxtehude genießen können.
          </p>
        </div>
      </div>

      <form class="form rim spot" method="post" action="#" novalidate data-reveal2>
        <span class="spot__light" aria-hidden="true"></span>
        <p class="form__label">Füllen Sie das untenstehende Formular aus.</p>

        <div class="form__row">
          <label class="field">
            <span class="field__label">Vorname</span>
            <input type="text" name="vorname" autocomplete="given-name" />
          </label>
          <label class="field">
            <span class="field__label">Nachname</span>
            <input type="text" name="nachname" autocomplete="family-name" />
          </label>
        </div>

        <label class="field">
          <span class="field__label">Email</span>
          <input type="email" name="email" autocomplete="email" />
        </label>

        <label class="field">
          <span class="field__label">Thema</span>
          <input type="text" name="thema" />
        </label>

        <label class="field">
          <span class="field__label">Hier schreiben...</span>
          <textarea name="nachricht" rows="5"></textarea>
        </label>

        {/* Honeypot plus a timing field, so the form stays fast and accessible
            without a CAPTCHA. Both are read by create-booking in stage 5. */}
        <div class="hp" aria-hidden="true">
          <label>Firma<input type="text" name="firma" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="ts" value="" />

        <button type="submit" class="pill gleam form__submit" disabled>Senden Sie</button>

        <p class="form__note">
          Das Formular wird derzeit noch angebunden. Bitte erreichen Sie mich in der Zwischenzeit
          telefonisch, per WhatsApp oder per E-Mail.
        </p>
      </form>
    </div>
  </section>

  {/* Direct channels. Each one is live: the status dot breathes, the well
      behind the icon pulses a ring, the rim brightens and a gleam crosses on
      approach. */}
  <section class="section--tight">
    <div class="shell">
      <p class="ways__eyebrow" data-fade>Oder direkt</p>

      <ul class="ways">
        {
          [
            { rank: 'Am schnellsten', label: 'Anrufen', value: BUSINESS.phone,
              href: `tel:${BUSINESS.phoneE164}`, status: 'Mo–Sa erreichbar',
              icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z' },
            { rank: 'Jederzeit', label: 'WhatsApp', value: BUSINESS.whatsapp,
              href: waLink, status: 'Antwort schnellstmöglich',
              icon: 'M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20.5l1.8-5.3A8.4 8.4 0 1 1 21 11.5Z' },
            { rank: 'Für Ausführliches', label: 'E-Mail', value: BUSINESS.email,
              href: `mailto:${BUSINESS.email}`, status: 'Antwort meist am selben Tag',
              icon: 'M3 6.5h18v11H3zM3 7l9 6 9-6' },
          ].map((w, i) => (
            <li
              class="way spot rim gleam float"
              data-reveal2
              style={`--reveal-delay:${i * 90}ms`}
            >
              <span class="spot__light" aria-hidden="true"></span>
              <span class="brackets" aria-hidden="true"><span></span><span></span><span></span><span></span></span>

              <a class="way__link" href={w.href} rel={w.href.startsWith('http') ? 'noopener' : undefined}>
                <span class="way__top">
                  <span class="way__well" aria-hidden="true">
                    <span class="way__ring"></span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round"><path d={w.icon} /></svg>
                  </span>
                  <span class="way__rank">{w.rank}</span>
                </span>

                <span class="way__label">{w.label}</span>
                <span class="way__value">{w.value}</span>

                <span class="way__foot">
                  <span class="way__status"><i aria-hidden="true"></i>{w.status}</span>
                  <svg class="way__arrow" viewBox="0 0 24 12" aria-hidden="true">
                    <path d="M0 6h21M16 1l5 5-5 5" fill="none" stroke="currentColor"
                          stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 2.5vw, 2rem); }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero__title { font-size: clamp(2.6rem, 7vw, 4.6rem); line-height: 1.02; }
  .hero__lede { margin-top: clamp(1.25rem, 2.5vw, 1.9rem); max-width: 40ch; }

  /* --- The orb ----------------------------------------------------------- */

  .hero__orb { position: relative; margin: 0; }

  /* Light pooling behind the cutout, so it reads as lit from the page rather
     than pasted on top of it. */
  .hero__orb-halo {
    position: absolute;
    inset: 4%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 46%,
      rgb(255 255 255 / 0.9) 0%,
      rgb(255 234 220 / 0.55) 42%,
      rgb(255 210 224 / 0.28) 66%,
      transparent 78%);
    filter: blur(14px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__orb-halo { animation: orb-breathe 9s ease-in-out infinite alternate; }
  }
  @keyframes orb-breathe {
    from { transform: scale(0.96); opacity: 0.85; }
    to   { transform: scale(1.06); opacity: 1; }
  }

  /* --- Form -------------------------------------------------------------- */

  .form__wrap {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .form__intro h2 { margin-bottom: 1.15rem; }
  .form__prose { max-width: 44ch; }
  .form__prose :global(p) { font-size: 0.9375rem; }

  .form {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.6rem, 3.4vw, 2.6rem);
    border-radius: 22px;
    background:
      radial-gradient(120% 80% at 90% 0%, var(--wash-sunset) 0%, transparent 58%),
      var(--surface-strong);
    box-shadow: 0 8px 40px rgb(43 38 34 / 0.08), inset 0 1px 0 rgb(255 255 255 / 0.8);
  }

  .form__label {
    margin: 0 0 0.3rem;
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }

  .field { display: grid; gap: 0.45rem; }

  .field__label {
    font-size: var(--step-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 46px;
    padding: 0.85rem 1.05rem;
    font-family: var(--font-body);
    font-size: var(--step-small);
    font-weight: 300;
    color: var(--ink);
    background: rgb(255 255 255 / 0.78);
    border: 0;
    border-radius: var(--radius-interactive);
    box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.16);
    transition: box-shadow 0.4s var(--ease), background 0.4s var(--ease);
  }

  .field textarea { resize: vertical; line-height: 1.6; }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    background: rgb(255 255 255 / 0.95);
    box-shadow: inset 0 0 0 2px var(--leaf), 0 6px 22px rgb(63 118 82 / 0.12);
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .form__submit { margin-top: 0.4rem; justify-self: start; }
  .form__submit:disabled { opacity: 0.45; cursor: not-allowed; }

  .form__note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-mute);
    font-style: italic;
  }

  /* --- Direct channels ---------------------------------------------------- */

  .ways__eyebrow {
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr));
    gap: clamp(0.9rem, 2vw, 1.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .way {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 20px;
    background:
      radial-gradient(130% 90% at 12% 100%, var(--wash-pink) 0%, transparent 60%),
      radial-gradient(110% 80% at 92% 4%, var(--wash-sunset) 0%, transparent 54%),
      var(--surface-strong);
    box-shadow: 0 4px 26px rgb(43 38 34 / 0.06), inset 0 1px 0 rgb(255 255 255 / 0.78);
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
  }

  .way__link {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 0.3rem;
    padding: clamp(1.35rem, 2.6vw, 1.75rem);
    min-height: 100%;
  }

  .way__top { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.6rem; }

  /* A lit well behind the icon, with a ring leaving it on a slow pulse. */
  .way__well {
    position: relative;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 50%;
    color: var(--leaf-text);
    background: radial-gradient(circle at 42% 34%, #ffffff 0%, rgb(151 198 147 / 0.32) 74%);
    box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.22), inset 0 2px 6px rgb(255 255 255 / 0.9),
                0 4px 12px rgb(43 38 34 / 0.07);
  }
  .way__well svg { width: 19px; height: 19px; }

  .way__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgb(63 118 82 / 0.5);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .way__ring { animation: well-pulse 3.4s var(--ease) infinite; }
    .way:nth-child(2) .way__ring { animation-delay: 1.1s; }
    .way:nth-child(3) .way__ring { animation-delay: 2.2s; }
  }
  @keyframes well-pulse {
    0%   { transform: scale(0.86); opacity: 0; }
    22%  { opacity: 0.7; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  .way__rank {
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .way__label {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.08;
    color: var(--ink);
  }

  .way__value {
    font-size: var(--step-small);
    color: var(--ink-soft);
    word-break: break-word;
  }

  .way__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgb(184 147 78 / 0.18);
  }

  .way__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  /* A live dot. Small, but it is what makes a card read as something running
     rather than something printed. */
  .way__status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px rgb(63 118 82 / 0.14);
  }

  @media (prefers-reduced-motion: no-preference) {
    .way__status i { animation: dot-breathe 2.6s ease-in-out infinite; }
  }
  @keyframes dot-breathe {
    0%, 100% { opacity: 0.55; box-shadow: 0 0 0 2px rgb(63 118 82 / 0.1); }
    50%      { opacity: 1;    box-shadow: 0 0 0 5px rgb(63 118 82 / 0.16); }
  }

  .way__arrow {
    width: 20px;
    height: 10px;
    flex: none;
    color: var(--leaf-text);
    transition: transform 0.5s var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .way:hover { transform: translateY(-5px); box-shadow: 0 22px 50px rgb(43 38 34 / 0.11); }
    .way:hover .way__label { color: var(--leaf-text); }
    .way:hover .way__arrow { transform: translateX(5px); }
    .way:hover .way__well { box-shadow: inset 0 0 0 1px rgb(63 118 82 / 0.45), 0 8px 20px rgb(63 118 82 / 0.16); }
  }

  /* --- Responsive --------------------------------------------------------- */

  @media (max-width: 900px) {
    .hero__inner, .form__wrap { grid-template-columns: 1fr; }
    .hero__orb { order: -1; max-width: 22rem; justify-self: center; width: 100%; }
  }

  @media (max-width: 520px) {
    .form__row { grid-template-columns: 1fr; }
  }
</style>
