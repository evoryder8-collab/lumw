---
/**
 * The stage every page stands on.
 *
 * The aurora wash and the grain are fixed layers behind the content, so they
 * cost one paint and never move in the layout. The display face is preloaded
 * because it draws the LCP element on every page; the body face is not, since
 * it renders below the fold on first paint and swap handles it.
 */
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MotionIsland from '../components/motion/MotionIsland.astro';
import ThumbBar from '../components/ThumbBar.astro';
import { ClientRouter } from 'astro:transitions';
import { url } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  schema?: unknown;
  /** srcset + sizes for the LCP image, so it starts downloading immediately. */
  preloadImage?: { srcset: string; sizes: string; type?: string };
}

const { title, description, path, ogImage, ogType, schema, preloadImage } = Astro.props;

const fontBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f2" />

    <link
      rel="preload"
      href={url('/fonts/fraunces-latin-var.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type ?? 'image/avif'}
          fetchpriority="high"
        />
      )
    }

    <style is:inline set:html={`
      @font-face {
        font-family: 'Fraunces';
        src: url('${fontBase}/fonts/fraunces-latin-var.woff2') format('woff2-variations');
        font-weight: 100 900; font-style: normal; font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Hanken Grotesk';
        src: url('${fontBase}/fonts/hankengrotesk-latin-var.woff2') format('woff2-variations');
        font-weight: 100 900; font-style: normal; font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD;
      }
    `} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap.xml')} />

    {/* View Transitions. Fallback is instant navigation, which is what a
        browser without support already does. */}
    <ClientRouter fallback="none" />

    <Meta {title} {description} {path} {ogImage} {ogType} />
    {schema && <JsonLd data={schema} />}
  </head>

  <body>
    <!-- The background itself is the heaven-like element. Static in stages 1-3;
         stage 6 animates these same two layers and nothing restructures. -->
    <div class="aurora" aria-hidden="true">
      <span class="aurora__blob aurora__blob--a"></span>
      <span class="aurora__blob aurora__blob--b"></span>
      <span class="aurora__blob aurora__blob--c"></span>
      <span class="aurora__blob aurora__blob--d"></span>
      <div class="aurora__conic"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>

    <div class="progress" aria-hidden="true"><div class="progress__bar" data-progress></div></div>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <ThumbBar />
    <MotionIsland />
  </body>
</html>
