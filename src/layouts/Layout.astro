---
/**
 * The stage every page stands on.
 *
 * The aurora wash and the grain are fixed layers behind the content, so they
 * cost one paint and never move in the layout. The display face is preloaded
 * because it draws the primary headings. The interface face also appears
 * above the fold; both preload, while unused display weights load on demand.
 */
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MotionIsland from '../components/motion/MotionIsland.astro';
import SocialDock from '../components/SocialDock.astro';
import WelcomeCurtain from '../components/WelcomeCurtain.astro';
import LanguagePortal from '../components/LanguagePortal.astro';
import JuneInvitation from '../components/JuneInvitation.astro';
import { ClientRouter } from 'astro:transitions';
import { url } from '../lib/site';
import { localeForPath, routeKeyForPath } from '../i18n/locales';
import { labels } from '../i18n/content';
import '../styles/global.css';
import '../styles/liquid-glass.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article' | 'profile';
  schema?: unknown;
  /** srcset + sizes for the LCP image, so it starts downloading immediately. */
  preloadImage?: { srcset: string; sizes: string; type?: string };
  /** Never index this page, whatever PUBLIC_INDEXABLE says. */
  noindex?: boolean;
  compact?: boolean;
}

const { title, description, path, ogType, schema, preloadImage, noindex, compact = false } = Astro.props;
const locale = localeForPath(path);
const ui = labels(locale);
const page = compact ? 'linkinbio' : routeKeyForPath(path) ?? (path.startsWith('/service-page/') ? 'service' : 'legal');

const fontBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f2" />
    <slot name="head" />

    <link
      rel="preload"
      href={url('/fonts/cormorant-garamond-display-light.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={url('/fonts/hankengrotesk-interface-var.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {page === 'home' && locale === 'de' && <link
      rel="preload"
      href={url('/fonts/cormorant-garamond-display-italic.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />}

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type ?? 'image/avif'}
          fetchpriority="high"
        />
      )
    }

    <style is:inline set:html={`
      @font-face {
        font-family: 'Cormorant Garamond';
        src: url('${fontBase}/fonts/cormorant-garamond-display-light.woff2') format('woff2');
        font-weight: 300; font-style: normal; font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        src: url('${fontBase}/fonts/cormorant-garamond-display-var.woff2') format('woff2-variations');
        font-weight: 301 700; font-style: normal; font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        src: url('${fontBase}/fonts/cormorant-garamond-display-italic.woff2') format('woff2');
        font-weight: 300; font-style: italic; font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Hanken Grotesk';
        src: url('${fontBase}/fonts/hankengrotesk-interface-var.woff2') format('woff2-variations');
        font-weight: 300 700; font-style: normal; font-display: swap;
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212, U+FEFF, U+FFFD;
      }
    `} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="shortcut icon" href={url('/favicon.ico')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap.xml')} />

    {/* View Transitions. Fallback is instant navigation, which is what a
        browser without support already does. */}
    <ClientRouter fallback="none" />

    <Meta {title} {description} {path} {ogType} {noindex} />
    {schema && <JsonLd data={schema} />}
  </head>

  <body data-page={page} data-locale={locale}>
    <!-- The background itself is the heaven-like element. Static in stages 1-3;
         stage 6 animates these same two layers and nothing restructures. -->
    <div class="aurora" aria-hidden="true">
      <span class="aurora__blob aurora__blob--a"></span>
      <span class="aurora__blob aurora__blob--b"></span>
      <span class="aurora__blob aurora__blob--c"></span>
      <span class="aurora__blob aurora__blob--d"></span>
      <div class="aurora__conic"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>

    {!compact && <><LanguagePortal {path} {locale} /><WelcomeCurtain {locale} /></>}
    <WelcomeCurtain {locale} mode="page" />

    {/* Standing disclaimer. June works by appointment only, and that is the
        single fact a visitor most needs before anything else on the page. It
        sits above the header rather than buried in a panel further down. */}
    {!compact && <p class="notice">
      <span class="notice__dot" aria-hidden="true"></span>
      {ui.appointment}
    </p>}

    <div class="progress" aria-hidden="true"><div class="progress__bar" data-progress></div></div>

    {!compact && <SiteHeader {locale} {path} />}

    <main id="main">
      <slot />
    </main>

    {!compact && <SiteFooter {locale} {path} />}

    {!compact && <SocialDock {locale} />}
    {page === 'home' && <JuneInvitation {locale} />}
    {!compact && <MotionIsland />}
    <script>import '../scripts/experience';</script>
  </body>
</html>
