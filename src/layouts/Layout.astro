---
/**
 * The stage every page stands on.
 *
 * The aurora wash and the grain are fixed layers behind the content, so they
 * cost one paint and never move in the layout. The display face is preloaded
 * because it draws the LCP element on every page; the body face is not, since
 * it renders below the fold on first paint and swap handles it.
 */
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  schema?: unknown;
  /** srcset + sizes for the LCP image, so it starts downloading immediately. */
  preloadImage?: { srcset: string; sizes: string; type?: string };
}

const { title, description, path, ogImage, ogType, schema, preloadImage } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f2" />

    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type ?? 'image/avif'}
          fetchpriority="high"
        />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <Meta {title} {description} {path} {ogImage} {ogType} />
    {schema && <JsonLd data={schema} />}
  </head>

  <body>
    <!-- The background itself is the heaven-like element. Static in stages 1-3;
         stage 6 animates these same two layers and nothing restructures. -->
    <div class="aurora" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
